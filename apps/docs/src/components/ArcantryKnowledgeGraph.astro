---
import { Icon } from '@astrojs/starlight/components';

type SetupState = Record<string, string>;
type Preset = {
  id: string;
  label: string;
  description: string;
  icon: 'padlock' | 'puzzle' | 'rocket';
  recommended?: boolean;
  state: SetupState;
};

const presets: Preset[] = [
  {
    id: 'full',
    label: 'Shared + private',
    description: 'Share team files. Keep personal guidance and tasks private.',
    icon: 'rocket',
    recommended: true,
    state: {
      'repository-skills': 'Project',
      'repository-guidance': 'Project',
      'repository-todo': 'Project',
      'repository-openspec': 'Manage',
      'repository-changelog': 'Manage',
      'local-guidance': 'Private',
      'local-todo': 'Private',
    },
  },
  {
    id: 'private',
    label: 'Private project',
    description: 'Keep project knowledge in .local, outside Git.',
    icon: 'padlock',
    state: {
      'computer-skills': 'User',
      'local-guidance': 'Private',
      'local-todo': 'Private',
      'local-openspec': 'Manage',
      'local-changelog': 'Manage',
    },
  },
  {
    id: 'selective',
    label: 'Selected sources',
    description: 'Connect only the sources this project needs.',
    icon: 'puzzle',
    state: {
      'computer-skills': 'User',
      'repository-todo': 'Project',
      'local-openspec': 'Read',
    },
  },
];

const scopes = [
  {
    id: 'computer',
    label: 'Computer',
    description: 'Available across projects.',
    icon: 'laptop' as const,
    sources: [{ id: 'computer-skills', label: 'Skills', description: 'Reusable procedures.', icon: 'puzzle' as const }],
  },
  {
    id: 'repository',
    label: 'Repository',
    description: 'Tracked in Git.',
    icon: 'code-branch' as const,
    sources: [
      { id: 'repository-skills', label: 'Skills', description: 'Reusable procedures.', icon: 'puzzle' as const },
      { id: 'repository-guidance', label: 'Guidance', description: 'Agent instructions.', icon: 'setting' as const },
      { id: 'repository-todo', label: 'todo.txt', description: 'Task queue.', icon: 'notes' as const },
      {
        id: 'repository-openspec',
        label: 'OpenSpec',
        description: 'Requirements and changes.',
        icon: 'open-book' as const,
      },
      {
        id: 'repository-changelog',
        label: 'Changelog',
        description: 'Release history.',
        icon: 'document' as const,
      },
    ],
  },
  {
    id: 'local',
    label: 'Private project',
    description: 'Stored in .local, outside Git.',
    icon: 'padlock' as const,
    sources: [
      { id: 'local-guidance', label: 'Guidance', description: 'Agent instructions.', icon: 'setting' as const },
      { id: 'local-todo', label: 'todo.txt', description: 'Task queue.', icon: 'notes' as const },
      {
        id: 'local-openspec',
        label: 'OpenSpec',
        description: 'Requirements and changes.',
        icon: 'open-book' as const,
      },
      {
        id: 'local-changelog',
        label: 'Changelog',
        description: 'Release history.',
        icon: 'document' as const,
      },
    ],
  },
];

const initialPreset = presets[0];
const initialState: SetupState = initialPreset.state;
const faviconHref = `${import.meta.env.BASE_URL}favicon.svg`;
---

<section class="knowledge-configurator" aria-labelledby="knowledge-configurator-title">
  <div class="configurator-heading">
    <p>Compose your setup</p>
    <h2 id="knowledge-configurator-title">See where each source lives</h2>
  </div>

  <arcantry-knowledge-graph data-preset={initialPreset.id}>
    <p class="preset-label">Common setups</p>

    <div class="preset-selector" role="group" aria-label="Arcantry setup presets">
      {presets.map((preset, index) => (
        <button
          type="button"
          aria-pressed={index === 0 ? 'true' : 'false'}
          data-preset={preset.id}
          data-state={JSON.stringify(preset.state)}
        >
          <Icon name={preset.icon} />
          <span class="preset-copy">
            <strong>{preset.label}</strong>
            <small>{preset.description}</small>
          </span>
          {preset.recommended && <em>Recommended</em>}
        </button>
      ))}
    </div>

    <div class="sync-wave" aria-hidden="true">
      <svg viewBox="0 0 1000 44" preserveAspectRatio="none">
        <title>Animated Arcantry synchronization wave</title>
        <defs>
          <linearGradient id="arcantry-sync-gradient" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="var(--ar-accent-blue)" />
            <stop offset="0.5" stop-color="var(--ar-accent-violet)" />
            <stop offset="1" stop-color="var(--ar-accent-pink)" />
          </linearGradient>
          <filter id="arcantry-sync-glow" x="-10%" y="-100%" width="120%" height="300%">
            <feGaussianBlur stdDeviation="1.5" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>
        <path class="sync-wave-guide" d="M0 22 H1000" />
        <path
          class="sync-wave-stream sync-wave-stream-a"
          d="M0 22 C150 22 190 8 300 8 S430 22 500 22 S570 36 700 36 S850 22 1000 22"
        />
        <path
          class="sync-wave-stream sync-wave-stream-b"
          d="M0 22 C150 22 190 36 300 36 S430 22 500 22 S570 8 700 8 S850 22 1000 22"
        />
      </svg>
      <span class="sync-mark"><img src={faviconHref} alt=""></span>
    </div>

    <div class="scope-grid">
      {scopes.map((scope) => (
        <section class="scope-column" data-scope={scope.id} aria-labelledby={`scope-${scope.id}`}>
          <header class="scope-heading">
            <Icon name={scope.icon} />
            <span>
              <strong id={`scope-${scope.id}`}>{scope.label}</strong>
              <small>{scope.description}</small>
            </span>
          </header>

          <ul>
            {scope.sources.map((source) => {
              const mode = initialState[source.id];
              return (
                <li
                  data-source={source.id}
                  data-source-label={source.label}
                  data-scope-label={scope.label}
                  data-active={mode ? 'true' : 'false'}
                  aria-label={`${source.label}, ${scope.label}: ${mode ?? 'not used'}`}
                >
                  <Icon name={source.icon} />
                  <span class="source-copy">
                    <strong>{source.label}</strong>
                    <small>{source.description}</small>
                  </span>
                  <span class="source-mode" data-source-mode>{mode ?? ''}</span>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </arcantry-knowledge-graph>

  <section class="setup-invitation" aria-labelledby="setup-invitation-title">
    <p>Your setup</p>
    <h3 id="setup-invitation-title">
      Every project has different boundaries. Build a setup that keeps its knowledge <span>safe</span>.
    </h3>
    <div class="setup-actions">
      <a class="setup-primary" href="/arcantry/adoption/#choose-an-adoption-path">
        <strong>Configure your setup</strong>
        <Icon name="right-arrow" />
      </a>
      <a class="setup-next" href="/arcantry/getting-started/" transition:name="arcantry-next-action">
        <small>Learn more</small>
        <strong>Explore the details</strong>
        <Icon name="right-arrow" />
      </a>
    </div>
  </section>
</section>

<script>
type SetupState = Record<string, string>;

class ArcantryKnowledgeGraph extends HTMLElement {
  connectedCallback(): void {
    this.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button) => {
      button.addEventListener('click', this.selectPreset);
    });
  }

  disconnectedCallback(): void {
    this.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button) => {
      button.removeEventListener('click', this.selectPreset);
    });
  }

  private selectPreset = (event: Event): void => {
    const button = event.currentTarget;
    if (!(button instanceof HTMLButtonElement)) return;

    let state: SetupState;
    try {
      state = JSON.parse(button.dataset.state ?? '') as SetupState;
    } catch {
      return;
    }

    this.dataset.preset = button.dataset.preset ?? '';
    this.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((preset) => {
      preset.setAttribute('aria-pressed', String(preset === button));
    });

    this.querySelectorAll<HTMLElement>('[data-source]').forEach((source) => {
      const mode = state[source.dataset.source ?? ''];
      source.dataset.active = mode ? 'true' : 'false';
      source.setAttribute(
        'aria-label',
        `${source.dataset.sourceLabel}, ${source.dataset.scopeLabel}: ${mode ?? 'not used'}`,
      );
      const modeLabel = source.querySelector<HTMLElement>('[data-source-mode]');
      if (modeLabel) modeLabel.textContent = mode ?? '';
    });
  };
}

if (!customElements.get('arcantry-knowledge-graph')) {
  customElements.define('arcantry-knowledge-graph', ArcantryKnowledgeGraph);
}
</script>

<style>
.knowledge-configurator {
  width: min(100%, 71rem);
  margin: 0 auto 7rem;
}
.configurator-heading {
  display: grid;
  grid-template-columns: minmax(8rem, 0.55fr) minmax(0, 1.45fr);
  gap: 1.5rem;
  align-items: start;
  margin-bottom: 1.7rem;
}
.configurator-heading > p {
  margin: 0.45rem 0 0 !important;
  color: var(--ar-accent-pink);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.configurator-heading h2 {
  max-width: 43rem;
  margin: 0 !important;
  color: var(--ar-text);
  font-family: var(--ar-font-serif);
  font-size: clamp(2rem, 4vw, 3rem) !important;
  line-height: 1.05 !important;
  letter-spacing: -0.035em;
}
arcantry-knowledge-graph {
  display: block;
}
.preset-label {
  margin: 0 0 0.7rem !important;
  color: var(--ar-text-muted);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.preset-selector {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 0 !important;
}
.preset-selector button {
  position: relative;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  gap: 0.7rem;
  align-items: start;
  min-width: 0;
  min-height: 6rem;
  margin: 0 !important;
  padding: 1rem;
  border: 0;
  border-top: 1px solid var(--ar-border);
  border-right: 1px solid var(--ar-border);
  border-bottom: 1px solid var(--ar-border);
  border-radius: 0;
  background: transparent;
  color: var(--ar-text-soft);
  cursor: pointer;
  font-family: var(--ar-font-sans) !important;
  text-align: left;
  transition:
    color 160ms ease,
    background-color 160ms ease;
}
.preset-selector button:first-child {
  border-left: 1px solid var(--ar-border);
}
.preset-selector button::after {
  position: absolute;
  right: 0;
  bottom: -1px;
  left: 0;
  height: 2px;
  background: transparent;
  content: '';
}
.preset-selector button:hover {
  color: var(--ar-text);
  background: color-mix(in srgb, var(--ar-text) 3%, transparent);
}
.preset-selector button[aria-pressed='true'] {
  color: var(--ar-text);
  background: color-mix(in srgb, var(--ar-accent-violet) 8%, transparent);
}
.preset-selector button[aria-pressed='true']::after {
  background: linear-gradient(90deg, var(--ar-accent-blue), var(--ar-accent-violet), var(--ar-accent-pink));
}
.preset-selector button:focus-visible {
  z-index: 1;
  outline: 2px solid var(--ar-accent-violet);
  outline-offset: -3px;
}
.preset-selector button > svg {
  width: 0.95rem;
  height: 0.95rem;
  margin-top: 0.1rem;
  color: var(--ar-accent-violet);
}
.preset-copy {
  display: grid;
  gap: 0.3rem;
  min-width: 0;
}
.preset-copy strong {
  color: inherit;
  font-size: 0.86rem;
  line-height: 1.2;
}
.preset-copy small {
  color: var(--ar-text-muted);
  font-size: 0.72rem;
  font-weight: 400;
  line-height: 1.4;
}
.preset-selector em {
  color: var(--ar-accent-violet);
  font-size: 0.56rem;
  font-style: normal;
  font-weight: 750;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.sync-wave {
  position: relative;
  display: grid;
  place-items: center;
  height: 3.4rem;
  margin: 0 !important;
  overflow: hidden;
}
.sync-wave svg {
  width: 100%;
  height: 100%;
  overflow: visible;
}
.sync-wave-guide,
.sync-wave-stream {
  fill: none;
  vector-effect: non-scaling-stroke;
}
.sync-wave-guide {
  stroke: var(--ar-border-soft);
  stroke-width: 1;
}
.sync-wave-stream {
  stroke: url('#arcantry-sync-gradient');
  stroke-width: 1.35;
  stroke-linecap: round;
  stroke-dasharray: 2 8;
  filter: url('#arcantry-sync-glow');
  animation: sync-flow 7s linear infinite;
}
.sync-wave-stream-b {
  animation-direction: reverse;
}
.sync-mark {
  position: absolute;
  display: grid;
  place-items: center;
  width: 2rem;
  height: 2rem;
  border: 1px solid color-mix(in srgb, var(--ar-accent-violet) 55%, var(--ar-border));
  background: var(--sl-color-bg);
  box-shadow: 0 0 1.2rem color-mix(in srgb, var(--ar-accent-violet) 22%, transparent);
  animation: sync-pulse 3.5s ease-in-out infinite;
}
.sync-mark img {
  width: 1rem;
  height: 1rem;
}
@keyframes sync-flow {
  to {
    stroke-dashoffset: -40;
  }
}
@keyframes sync-pulse {
  50% {
    border-color: color-mix(in srgb, var(--ar-accent-pink) 70%, var(--ar-border));
    box-shadow: 0 0 1.5rem color-mix(in srgb, var(--ar-accent-pink) 28%, transparent);
  }
}
.scope-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 0 !important;
}
.scope-column {
  --scope-color: var(--ar-accent-violet);
  min-width: 0;
  min-height: 20rem;
  margin: 0 !important;
  border-top: 2px solid var(--scope-color);
  border-right: 1px solid var(--ar-border);
  border-bottom: 1px solid var(--ar-border);
  background: color-mix(in srgb, var(--scope-color) 2%, transparent);
}
.scope-column:first-child {
  border-left: 1px solid var(--ar-border);
}
.scope-column[data-scope='computer'] {
  --scope-color: var(--ar-accent-blue);
}
.scope-column[data-scope='repository'] {
  --scope-color: var(--ar-accent-pink);
}
.scope-column[data-scope='local'] {
  --scope-color: var(--ar-accent-violet);
}
.scope-heading {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 0.7rem;
  align-items: center;
  min-height: 4.7rem;
  padding: 0.9rem 1rem;
  border-bottom: 1px solid var(--ar-border);
}
.scope-heading > svg {
  width: 1rem;
  height: 1rem;
  color: var(--scope-color);
}
.scope-heading span {
  display: grid;
  gap: 0.2rem;
}
.scope-heading strong {
  color: var(--ar-text);
  font-size: 0.9rem;
}
.scope-heading small {
  color: var(--ar-text-muted);
  font-size: 0.72rem;
  line-height: 1.35;
}
.scope-column ul {
  margin: 0 !important;
  padding: 0 !important;
  list-style: none;
}
.scope-column li {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  gap: 0.65rem;
  align-items: center;
  min-width: 0;
  min-height: 3.45rem;
  margin: 0 !important;
  padding: 0.65rem 0.8rem;
  border-bottom: 1px solid var(--ar-border-soft);
  background: color-mix(in srgb, var(--scope-color) 1.5%, transparent);
  transition: background-color 160ms ease;
}
.scope-column li[data-active='false'] {
  background: transparent;
}
.scope-column li > * {
  transition: opacity 160ms ease;
}
.scope-column li[data-active='false'] > * {
  opacity: 0.28;
}
.scope-column li > svg {
  width: 0.85rem;
  height: 0.85rem;
  color: var(--scope-color);
}
.source-copy {
  display: grid;
  gap: 0.1rem;
  min-width: 0;
}
.source-copy strong {
  overflow: hidden;
  color: var(--ar-text);
  font-size: 0.8rem;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.source-copy small {
  overflow: hidden;
  color: var(--ar-text-muted);
  font-size: 0.68rem;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.source-mode {
  color: var(--scope-color);
  font-size: 0.65rem;
  font-weight: 700;
}
.scope-column li[data-active='false'] .source-mode {
  display: none;
}
.setup-invitation {
  display: grid;
  grid-template-columns: minmax(8rem, 0.55fr) minmax(0, 1.45fr);
  gap: 0.5rem 1.5rem;
  margin: 2.4rem 0 0 !important;
}
.setup-invitation > p {
  margin: 0.35rem 0 0 !important;
  color: var(--ar-accent-blue);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.setup-invitation h3 {
  max-width: 46rem;
  margin: 0 !important;
  color: var(--ar-text);
  font-family: var(--ar-font-serif);
  font-size: clamp(1.55rem, 3vw, 2.25rem) !important;
  line-height: 1.12 !important;
  letter-spacing: -0.025em;
}
.setup-invitation h3 span {
  background: linear-gradient(90deg, var(--ar-accent-blue), var(--ar-accent-violet), var(--ar-accent-pink));
  background-clip: text;
  color: transparent;
}
.setup-actions {
  display: grid;
  grid-column: 1 / -1;
  grid-template-columns: minmax(0, 2fr) minmax(12rem, 1fr);
  gap: 0.75rem;
  margin: 1.25rem 0 0 !important;
}
.setup-actions a {
  position: relative;
  min-width: 0;
  min-height: 4.6rem;
  margin: 0 !important;
  overflow: hidden;
  border: 1px solid transparent;
  border-radius: 0.25rem;
  background:
    linear-gradient(var(--ar-bg), var(--ar-bg)) padding-box,
    linear-gradient(105deg, var(--ar-accent-blue), var(--ar-accent-violet), var(--ar-accent-pink)) border-box;
  color: var(--ar-text);
  text-decoration: none;
  transition:
    background-color 160ms ease,
    box-shadow 160ms ease;
}
.setup-actions a:hover {
  background:
    linear-gradient(
      color-mix(in srgb, var(--ar-accent-violet) 7%, var(--ar-bg)),
      color-mix(in srgb, var(--ar-accent-violet) 7%, var(--ar-bg))
    )
    padding-box,
    linear-gradient(105deg, var(--ar-accent-blue), var(--ar-accent-violet), var(--ar-accent-pink)) border-box;
  box-shadow: 0 0 2rem color-mix(in srgb, var(--ar-accent-violet) 16%, transparent);
}
.setup-actions a:focus-visible {
  outline: 2px solid var(--ar-accent-blue);
  outline-offset: 3px;
}
.setup-actions svg {
  width: 1rem;
  height: 1rem;
  color: var(--ar-accent-pink);
}
.setup-primary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1rem 1.2rem;
}
.setup-primary strong {
  font-size: 1rem;
  line-height: 1.25;
}
.setup-next {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-content: center;
  gap: 0.15rem 0.75rem;
  padding: 0.8rem 1rem;
}
.setup-next small {
  color: var(--ar-text-muted);
  font-size: 0.68rem;
  line-height: 1.2;
}
.setup-next strong {
  overflow: hidden;
  font-size: 0.9rem;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.setup-next svg {
  grid-column: 2;
  grid-row: 1 / span 2;
  align-self: center;
}

@media (max-width: 64rem) {
  .scope-column li {
    grid-template-columns: auto minmax(0, 1fr);
  }
  .source-mode {
    grid-column: 2;
  }
}
@media (max-width: 49.99rem) {
  .knowledge-configurator {
    margin-bottom: 5rem;
  }
  .configurator-heading {
    grid-template-columns: 1fr;
    gap: 0.65rem;
  }
  .preset-selector button {
    grid-template-columns: 1fr;
    justify-items: center;
    gap: 0.35rem;
    min-height: 7.4rem;
    padding: 0.75rem 0.45rem;
    text-align: center;
  }
  .preset-selector button > svg {
    margin-top: 0;
  }
  .preset-copy {
    justify-items: center;
  }
  .preset-copy strong {
    font-size: 0.76rem;
  }
  .preset-copy small {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.65rem;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  .preset-selector em {
    font-size: 0.5rem;
  }
  .scope-grid {
    grid-template-columns: 1fr;
  }
  .scope-column {
    min-height: 0;
    border-left: 1px solid var(--ar-border);
  }
  .scope-heading {
    min-height: 4.2rem;
  }
  .scope-column li {
    grid-template-columns: auto minmax(0, 1fr) auto;
  }
  .source-mode {
    grid-column: auto;
  }
  .source-copy strong {
    font-size: 0.86rem;
  }
  .source-copy small {
    font-size: 0.72rem;
  }
  .source-mode {
    font-size: 0.7rem;
  }
  .setup-invitation {
    grid-template-columns: 1fr;
    gap: 0.55rem;
    margin-top: 2rem !important;
  }
  .setup-invitation > p {
    margin-top: 0 !important;
  }
  .setup-actions {
    grid-template-columns: 1fr;
    margin-top: 0.9rem !important;
  }
  .setup-actions a {
    min-height: 4.2rem;
  }
}
@media (max-width: 24rem) {
  .preset-selector button {
    min-height: 7.8rem;
  }
  .preset-copy strong {
    font-size: 0.68rem;
  }
  .preset-copy small {
    font-size: 0.6rem;
  }
  .scope-column li {
    grid-template-columns: auto minmax(0, 1fr);
