---
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/types';
import ArcantrySidebarLink from './ArcantrySidebarLink.astro';

type SidebarLink = {
  type: 'link';
  label: string;
  href: string;
  isCurrent: boolean;
};

type SidebarGroup = {
  type: 'group';
  label: string;
  entries: SidebarEntry[];
  collapsed: boolean;
};

type SidebarEntry = SidebarLink | SidebarGroup;

interface Props {
  entry: SidebarEntry;
  depth?: number;
  insideSkillCatalog?: boolean;
}

const { entry, depth = 0, insideSkillCatalog = false } = Astro.props;
const skillCatalog = insideSkillCatalog || (entry.type === 'group' && entry.label === 'Skill catalog');
const containsCurrent = (candidate: SidebarEntry): boolean =>
  candidate.type === 'link' ? candidate.isCurrent : candidate.entries.some(containsCurrent);

const icons: Record<string, StarlightIcon> = {
  Homepage: 'rocket',
  'Get started': 'approve-check',
  'Adoption paths': 'approve-check',
  Skills: 'puzzle',
  'Skill catalog': 'list-format',
  'Catalog overview': 'list-format',
  CLI: 'setting',
  Configuration: 'setting',
  'Inspect, plan and apply': 'code-branch',
  'todo.txt queues': 'list-format',
  'Project knowledge stack': 'document',
  'Change lifecycle': 'document',
  'Release lifecycle': 'star',
  'Contributor commands': 'open-book',
};

const iconFor = (candidate: SidebarEntry): StarlightIcon => {
  if (skillCatalog && candidate.type === 'link' && candidate.label !== 'Catalog overview') return 'document';
  if (skillCatalog && candidate.type === 'group') return 'list-format';
  return icons[candidate.label] ?? 'document';
};
---

{entry.type === 'link' ? (
  <ArcantrySidebarLink
    href={entry.href}
    label={entry.label}
    icon={iconFor(entry)}
    depth={depth}
    active={entry.isCurrent}
  />
) : (
  <details class:list={['nav-subgroup', { 'nav-nested': depth > 0 }]} open={!entry.collapsed || containsCurrent(entry)} style={`--nav-depth: ${depth}`}>
    <summary>
      <span class="nav-icon-slot" aria-hidden="true"><Icon name={iconFor(entry)} /></span>
      <span>{entry.label}</span>
      <Icon class="nav-caret" name="right-caret" aria-hidden="true" />
    </summary>
    <div class="nav-subitems">
      {entry.entries.map((child) => (
        <Astro.self entry={child} depth={depth + 1} insideSkillCatalog={skillCatalog} />
      ))}
    </div>
  </details>
)}

<style>
@layer starlight.core {
  .nav-icon-slot {
    display: grid;
    width: 0.9rem;
    flex: 0 0 0.9rem;
    place-items: center;
  }
  .nav-subgroup {
    margin-inline: -0.9rem;
  }
  .nav-subgroup.nav-nested {
    margin-inline: 0;
  }
  .nav-subgroup > summary {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.9rem 0.5rem calc(1.6rem + var(--nav-depth, 0) * 1.15rem);
    color: var(--ar-text-muted);
    cursor: pointer;
    font-size: 0.83rem;
    font-weight: 560;
    letter-spacing: -0.015em;
    list-style: none;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }
  .nav-subgroup > summary::-webkit-details-marker,
  .nav-subgroup > summary::marker {
    content: '';
    display: none;
  }
  .nav-subgroup > summary:hover {
    color: var(--ar-text);
    background: var(--ar-surface);
  }
  .nav-subgroup > summary :global(svg) {
    color: var(--ar-text-soft);
    font-size: 0.9rem;
    transition:
      color 150ms ease,
      transform 150ms ease;
  }
  .nav-subgroup > summary:hover :global(svg) {
    color: var(--ar-accent-blue);
  }
  .nav-subgroup[open] > summary {
    color: var(--ar-text);
  }
  .nav-subgroup[open] > summary > :global(.nav-caret) {
    transform: rotate(90deg);
  }
  .nav-subitems {
    display: grid;
    gap: 0.08rem;
    padding-bottom: 0.2rem;
  }
}
</style>
