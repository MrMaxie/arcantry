---
import ArcantrySidebarEntry from './ArcantrySidebarEntry.astro';
import ArcantrySidebarFooter from './ArcantrySidebarFooter.astro';

const { sidebar } = Astro.locals.starlightRoute;
---

<div class="navigation">
  {sidebar.map((entry) => (
    entry.type === 'link' ? (
      <ArcantrySidebarEntry entry={entry} />
    ) : (
      <section class="nav-group">
        <div class="nav-label">{entry.label}</div>
        <div class="nav-items">
          {entry.entries.map((item) => <ArcantrySidebarEntry entry={item} />)}
        </div>
      </section>
    )
  ))}
</div>

<ArcantrySidebarFooter />

<style>
@layer starlight.core {
  :global(.arcantry-sidebar-pane) {
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .navigation {
    flex: 1;
    padding: 1.5rem 0.9rem 2rem;
  }
  .nav-group + .nav-group,
  .nav-link + .nav-group {
    margin-top: 1.7rem;
  }
  .nav-label {
    padding: 0 0.7rem 0.5rem;
    color: var(--ar-text-soft);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .nav-items {
    display: grid;
    gap: 0.1rem;
  }
}
</style>
