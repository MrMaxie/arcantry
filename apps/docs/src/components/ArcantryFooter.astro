---
import { Icon } from '@astrojs/starlight/components';
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';
import { faHeart } from '@fortawesome/free-solid-svg-icons';
import packageManifest from '../../../../packages/arcantry/package.json';

const { hasSidebar } = Astro.locals.starlightRoute;
const [heartWidth, heartHeight, , , heartPath] = faHeart.icon;
const heartPathData = Array.isArray(heartPath) ? heartPath[0] : heartPath;
---

<footer class="page-footer">
  {Boolean(hasSidebar) && (
    <div class="page-meta">
      <EditLink />
      <LastUpdated />
    </div>
  )}
  {Boolean(hasSidebar) && (
    <div class="pagination-transition" transition:name="arcantry-next-action">
      <Pagination />
    </div>
  )}
  {!hasSidebar && (
    <div class="project-footer">
      <span class="footer-credit">
        Created with <span class="sr-only">love</span>
        <span class="footer-heart" aria-hidden="true">
          <svg viewBox={`0 0 ${heartWidth} ${heartHeight}`} aria-hidden="true"><path d={heartPathData} /></svg>
        </span>
        by <a href="https://maxie.dev">Maxie</a>
      </span>
      <div class="project-footer-links">
        <LastUpdated />
        <a href="https://github.com/MrMaxie/arcantry/blob/master/LICENSE">{packageManifest.license}</a>
        <a href="https://github.com/MrMaxie/arcantry" aria-label="Arcantry on GitHub">
          <Icon name="github" />
          <span>GitHub</span>
        </a>
      </div>
    </div>
  )}
</footer>

<style>
@layer starlight.core {
  .page-footer {
    display: grid;
    gap: 1.1rem;
  }
  .page-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 3rem;
    margin-top: 2.25rem;
    color: var(--ar-text-soft);
    font-size: var(--sl-text-sm);
  }
  :global(.pagination-links) {
    grid-template-columns: repeat(2, minmax(0, 14rem));
    justify-content: center;
    gap: 0.75rem;
  }
  :global(.pagination-links:has(a:only-child)) {
    grid-template-columns: minmax(0, 14rem);
  }
  :global(.pagination-links a[rel='next']:only-child) {
    grid-column: 1;
  }
  :global(.pagination-links a) {
    min-height: 0;
    padding: 0.7rem 0.85rem;
    border-radius: 0.25rem;
    box-shadow: none;
  }
  :global(.pagination-links .link-title) {
    font-size: 0.92rem;
    line-height: 1.25;
  }
  :global(.pagination-links a > span:first-child) {
    font-size: 0.68rem;
  }
  :global(.pagination-links svg) {
    width: 1rem;
    height: 1rem;
  }
  .pagination-transition {
    min-width: 0;
  }
  @media (max-width: 32rem) {
    :global(.pagination-links) {
      grid-template-columns: 1fr;
    }
    :global(.pagination-links a[rel='next']:only-child) {
      grid-column: 1;
    }
  }
}
</style>
