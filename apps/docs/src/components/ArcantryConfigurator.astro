---
const questions = [
  {
    key: 'm',
    title: 'What do you want the agent to do?',
    options: [
      ['evaluate', 'Check whether Arcantry fits my project'],
      ['new', 'Start using Arcantry in my project'],
      ['existing', 'Review my existing Arcantry setup'],
    ],
  },
  {
    key: 'i',
    title: 'Can the agent run the Arcantry CLI?',
    options: [
      ['yes', 'Yes, it is installed'],
      ['no', 'No, use the project files directly'],
      ['unsure', "I don't know - let the agent check"],
    ],
  },
  {
    key: 'r',
    title: 'Is the project already in Git?',
    options: [
      ['yes', 'Yes, with a remote'],
      ['no-github', 'Yes, without a remote'],
      ['no', 'No, it does not use Git'],
      ['unsure', "I don't know - let the agent check"],
    ],
  },
  {
    key: 'g',
    title: 'Would local Git history help?',
    options: [
      ['no', 'Continue without Git'],
      ['explain', 'Explain it before I decide'],
      ['yes', 'Propose local Git setup'],
    ],
  },
  {
    key: 's',
    title: 'Where should Arcantry keep project-specific setup?',
    options: [
      ['private', 'Privately for me'],
      ['shared', 'In the project for collaborators'],
      ['external', 'Outside the project'],
      ['recommend', 'Recommend the smallest useful setup'],
    ],
  },
  {
    key: 'c',
    title: 'What needs attention?',
    options: [
      ['sources', 'Knowledge sources'],
      ['guidance', 'Agent instructions'],
      ['boundaries', 'Private and shared boundaries'],
      ['repair', 'Drifting setup'],
      ['unsure', 'Let inspection decide'],
    ],
  },
  {
    key: 'x',
    title: 'How far should the agent go?',
    options: [
      ['plan', 'Inspect and prepare a plan'],
      ['apply', 'Prepare changes for my approval'],
    ],
  },
];
---

<arcantry-configurator class="not-content">
  <header class="setup-intro">
    <h1>Create instructions for your coding agent.</h1>
    <p>
      Open the project you want to work on in a coding agent. Then choose a goal here and copy the generated
      instructions into that agent. This page does not access or change your files.
    </p>
  </header>
  <div class="setup-columns">
    <nav class="setup-stages" aria-label="Setup stages">
      <p>Setup stages</p>
      <ol>
        {questions.map((question, index) => (
          <li>
            <button type="button" data-stage={question.key} disabled={index > 0}>
              <span class="stage-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span>{question.title}</span>
            </button>
          </li>
        ))}
      </ol>
    </nav>
    <form>
      <div class="section-heading">
        <h2>Your setup</h2>
        <button type="reset" hidden>Reset choices</button>
      </div>
      {questions.map((question, index) => (
        <fieldset data-question={question.key} hidden={index > 0}>
          <legend>
            <span class="question-number">Question {String(index + 1).padStart(2, '0')}</span>
            <span>{question.title}</span>
          </legend>
          <div class="options">
            {question.options.map(([value, label]) => (
              <label><input type="radio" name={question.key} value={value} />{label}</label>
            ))}
          </div>
        </fieldset>
      ))}
    </form>
    <section class="request" data-state="empty" aria-labelledby="request-title">
      <div class="request-heading">
        <p class="request-label" data-request-label>Next step</p>
        <h2 id="request-title" data-request-title>What happens next</h2>
        <p data-status role="status">
          Choose the outcome you want in the first question. We will ask only what matters, then show the exact text to
          paste into your coding agent.
        </p>
      </div>
      <!-- biome-ignore lint/a11y/noNoninteractiveTabindex: The scrollable request must be reachable for keyboard scrolling. -->
      <section class="request-body" aria-label="Generated agent instructions" tabindex="0" hidden>
        <pre data-prompt>Your instructions will appear here.</pre>
      </section>
      <div class="request-actions" hidden>
        <button type="button" data-copy disabled>Copy instructions</button>
      </div>
      <div class="request-notes" hidden>
        <a href="/getting-started/">Read the three-command workflow</a>
      </div>
    </section>
  </div>
</arcantry-configurator>

<script>
class ArcantryConfigurator extends HTMLElement {
  private startedEmpty = true;
  private abort?: AbortController;
  private value(key: string): string {
    return this.querySelector<HTMLInputElement>(`input[name="${key}"]:checked`)?.value ?? '';
  }
  connectedCallback() {
    this.abort = new AbortController();
    const options = { signal: this.abort.signal };
    this.restore();
    this.startedEmpty = !this.querySelector('input:checked');
    this.querySelector('form')?.addEventListener('change', () => this.render(), options);
    for (const stage of this.querySelectorAll<HTMLButtonElement>('[data-stage]')) {
      stage.addEventListener(
        'click',
        () => {
          const field = this.querySelector<HTMLFieldSetElement>(`[data-question="${stage.dataset.stage}"]`);
          const behavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
          field?.querySelector('legend')?.scrollIntoView({ behavior, block: 'center' });
          field?.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
        },
        options,
      );
    }
    this.querySelector('form')?.addEventListener(
      'reset',
      (event) => {
        event.preventDefault();
        for (const input of this.querySelectorAll<HTMLInputElement>('input')) input.checked = false;
        this.render();
      },
      options,
    );
    this.querySelector('[data-copy]')?.addEventListener(
      'click',
      async () => {
        const prompt = this.querySelector('[data-prompt]')?.textContent ?? '';
        try {
          await navigator.clipboard.writeText(prompt);
          this.status('Instructions copied.');
        } catch {
          this.status('Copy is unavailable. Select and copy the instructions below.');
        }
      },
      options,
    );
    window.addEventListener('popstate', () => this.restore(), options);
    window.addEventListener(
      'beforeunload',
      (event) => {
        if (this.startedEmpty && this.querySelector('input:checked')) {
          event.preventDefault();
        }
      },
      options,
    );
    document.addEventListener(
      'astro:before-preparation',
      (event) => {
        if (this.startedEmpty && this.querySelector('input:checked') && !window.confirm('Leave your setup choices?'))
          event.preventDefault();
      },
      options,
    );
  }
  disconnectedCallback() {
    this.abort?.abort();
  }
  private status(text: string) {
    const status = this.querySelector('[data-status]');
    if (status) status.textContent = text;
  }
  private restore() {
    const params = new URL(location.href).searchParams;
    for (const input of this.querySelectorAll<HTMLInputElement>('input')) {
      input.checked = params.get(input.name) === input.value;
    }
    this.render();
  }
  private render() {
    let reachable = true;
    const mode = this.value('m');
    for (const field of this.querySelectorAll<HTMLFieldSetElement>('fieldset')) {
      const key = field.dataset.question ?? '';
      const relevant = (key !== 'g' || this.value('r') === 'no') && (key !== 'c' || mode === 'existing');
      field.hidden = !reachable || !relevant;
      if (field.hidden) {
        for (const input of field.querySelectorAll<HTMLInputElement>('input')) input.checked = false;
      } else if (!this.value(key)) reachable = false;
    }
    const visibleFields = [...this.querySelectorAll<HTMLFieldSetElement>('fieldset:not([hidden])')];
    for (const stage of this.querySelectorAll<HTMLButtonElement>('[data-stage]')) {
      const field = this.querySelector<HTMLFieldSetElement>(`[data-question="${stage.dataset.stage}"]`);
      stage.disabled = field === null || field.hasAttribute('hidden');
      if (field && visibleFields.at(-1) === field && !this.value(field.dataset.question ?? '')) {
        stage.setAttribute('aria-current', 'step');
      } else {
        stage.removeAttribute('aria-current');
      }
    }
    const url = new URL(location.href);
    // Only known, applicable answers survive normalization, including old URLs.
    url.search = '';
    for (const input of this.querySelectorAll<HTMLInputElement>('input:checked'))
      url.searchParams.set(input.name, input.value);
    history.replaceState(null, '', url);
    const installed = this.value('i');
    const scope = this.value('s');
    const lines = [
      mode === 'existing'
        ? 'Review the existing Arcantry setup in the project currently open in your workspace before proposing changes.'
        : mode === 'new'
          ? 'Help me start using only the useful parts of Arcantry in the project currently open in your workspace.'
          : 'Evaluate whether Arcantry would help the project currently open in your workspace. Do not change files.',
      installed === 'no'
        ? 'Work directly from project source files. CLI installation is not a prerequisite.'
        : installed === 'yes'
          ? 'Run arcantry context, arcantry next, and arcantry explain tasks to understand the project and its next step.'
          : 'Check whether the arcantry command is available. If it is, run arcantry context, arcantry next, and arcantry explain tasks. If it is missing, continue from project source files.',
      'Read AGENTS.md, the selected Arcantry configuration, OpenSpec configuration and the selected change tasks and schema templates. Preserve existing work and project conventions. Report conflicts and missing facts without inventing permission.',
    ];
    if (this.value('r') === 'yes')
      lines.push('Preserve the existing Git repository and all tracked and untracked work.');
    if (this.value('r') === 'no-github')
      lines.push('Preserve the existing local Git repository. Do not create or connect a remote.');
    if (this.value('g') === 'no') lines.push('Continue without Git.');
    if (['yes', 'explain'].includes(this.value('g')))
      lines.push('Explain the value of local Git and propose initialization separately; do not initialize it yet.');
    if (scope === 'private')
      lines.push(
        'Keep configuration private in .local, excluded through .git/info/exclude when Git is present. Never promote private content implicitly.',
      );
    if (scope === 'shared')
      lines.push('Propose shared configuration only for information collaborators need. Keep private context private.');
    if (scope === 'external')
      lines.push('Keep the target project unchanged; propose external configuration only if useful.');
    if (scope === 'recommend') lines.push('Recommend the smallest useful scope based on the inspected sources.');
    if (this.value('c')) lines.push(`Focus inspection on: ${this.value('c')}.`);
    const authority = this.value('x');
    lines.push(
      !reachable || authority === 'inspect'
        ? 'Inspect and recommend only. Do not install, initialize or modify anything.'
        : authority === 'plan'
          ? 'Prepare a concrete change plan with scope, dependencies, verification and unresolved decisions. Do not modify files.'
          : 'Prepare one exact preview of the proposed changes for my approval. Apply only after that approval, then verify the result.',
    );
    lines.push(
      'Implementation, commit, deployment and release are separate decisions. Finish with the next useful action and its required format.',
    );
    const prompt = this.querySelector('[data-prompt]');
    if (prompt) prompt.textContent = mode ? lines.join('\n\n') : 'Your instructions will appear here.';
    const request = this.querySelector<HTMLElement>('.request');
    const hasRequest = Boolean(mode);
    if (request) request.dataset.state = hasRequest ? (reachable ? 'ready' : 'building') : 'empty';
    const requestTitle = this.querySelector<HTMLElement>('[data-request-title]');
    if (requestTitle) requestTitle.textContent = hasRequest ? 'Instructions for your agent' : 'What happens next';
    const requestLabel = this.querySelector<HTMLElement>('[data-request-label]');
    if (requestLabel) requestLabel.textContent = hasRequest ? 'Generated request' : 'Next step';
    const requestBody = this.querySelector<HTMLElement>('.request-body');
    if (requestBody) requestBody.hidden = !hasRequest;
    const requestActions = this.querySelector<HTMLElement>('.request-actions');
    if (requestActions) requestActions.hidden = !hasRequest;
    const requestNotes = this.querySelector<HTMLElement>('.request-notes');
    if (requestNotes) requestNotes.hidden = !hasRequest;
    const copy = this.querySelector<HTMLButtonElement>('[data-copy]');
    if (copy) copy.disabled = !hasRequest;
    const reset = this.querySelector<HTMLButtonElement>('button[type="reset"]');
    if (reset) reset.hidden = !this.querySelector('input:checked');
    this.status(
      reachable
        ? 'Ready to copy. Review the instructions below.'
        : mode
          ? 'Answer the next question. Until then, the instructions only allow inspection.'
          : 'Choose the outcome you want in the first question. We will ask only what matters, then show the exact text to paste into your coding agent.',
    );
  }
}
if (!customElements.get('arcantry-configurator')) customElements.define('arcantry-configurator', ArcantryConfigurator);
</script>

<style>
arcantry-configurator {
  display: block;
  color: var(--ar-text);
}
h1,
h2,
p,
pre {
  margin: 0;
}
.setup-intro {
  display: grid;
  gap: 1rem;
  max-width: 50rem;
  margin-bottom: 2.5rem;
}
h1 {
  font-size: clamp(2rem, 4vw, 2.5rem);
  line-height: 1.2;
  letter-spacing: -0.035em;
}
h2 {
  font-size: 1.25rem;
  line-height: 1.4;
}
p {
  color: var(--ar-text-muted);
  line-height: 1.6;
}
.setup-columns {
  display: grid;
  grid-template-columns: minmax(11rem, 0.55fr) minmax(20rem, 1fr) minmax(22rem, 1.1fr);
  gap: clamp(2rem, 4vw, 3rem);
  align-items: start;
}
form,
.request {
  min-width: 0;
}
.setup-stages {
  position: sticky;
  top: 5.5rem;
  min-width: 0;
  padding-top: clamp(1.25rem, 2.5vw, 2rem);
}
.setup-stages > p {
  margin-bottom: 0.65rem;
  color: var(--ar-text-soft);
  font-size: 0.64rem;
  font-weight: 750;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}
.setup-stages ol {
  display: grid;
  gap: 0.25rem;
  margin: 0;
  padding: 0;
  list-style: none;
}
.setup-stages button {
  display: grid;
  grid-template-columns: 1.5rem minmax(0, 1fr);
  align-items: center;
  gap: 0.45rem;
  width: 100%;
  min-height: 2.75rem;
  padding: 0.55rem 0.65rem;
  border: 1px solid transparent;
  border-radius: 0.2rem;
  background: transparent;
  color: var(--ar-text-muted);
  text-align: left;
  font-size: 0.76rem;
  font-weight: 400;
  line-height: 1.35;
}
.stage-number {
  color: var(--ar-text-soft);
  font-size: 0.6rem;
  font-weight: 750;
  letter-spacing: 0.08em;
}
.setup-stages button:not(:disabled):hover,
.setup-stages button[aria-current='step'] {
  border-color: var(--ar-border);
  background: var(--ar-bg-subtle);
  color: var(--ar-text);
}
.setup-stages button[aria-current='step'] {
  font-weight: 650;
}
.setup-stages button[aria-current='step'] .stage-number {
  color: var(--ar-accent-blue);
}
.setup-stages button:disabled {
  opacity: 0.45;
}
form {
  display: grid;
  gap: 2rem;
  padding-top: clamp(1.25rem, 2.5vw, 2rem);
}
.section-heading {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem 1rem;
  padding-bottom: 0.9rem;
  border-bottom: 1px solid var(--ar-border);
}
.section-heading h2 {
  font-size: 1.45rem;
  letter-spacing: -0.025em;
}
fieldset {
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
}
fieldset[hidden] {
  display: none;
}
legend {
  display: grid;
  gap: 0.3rem;
  padding: 0;
  margin-bottom: 0.9rem;
  font-weight: 650;
  line-height: 1.4;
}
.question-number {
  color: var(--ar-accent-violet);
  font-size: 0.62rem;
  font-weight: 750;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}
.options {
  display: grid;
  gap: 0.5rem;
}
label {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  min-height: 3rem;
  padding: 0.75rem 1rem;
  border: 1px solid var(--ar-border);
  border-radius: 0.4rem;
  line-height: 1.5;
  cursor: pointer;
}
input {
  flex: 0 0 auto;
  width: 1rem;
  height: 1rem;
  margin: 0;
  accent-color: var(--ar-accent-blue);
}
label:hover,
button:not(:disabled):hover {
  background: var(--ar-surface);
  border-color: var(--ar-text-muted);
}
label:has(input:checked) {
  background: var(--ar-surface);
  border-color: var(--ar-accent-blue);
}
button {
  min-height: 2.75rem;
  padding: 0.65rem 1rem;
  border: 1px solid var(--ar-border);
  border-radius: 0.4rem;
  background: var(--ar-surface);
  color: var(--ar-text);
  font: inherit;
  font-weight: 650;
  line-height: 1.4;
  cursor: pointer;
}
button[type='reset'] {
  background: transparent;
  font-size: 0.85rem;
  font-weight: 400;
}
button[hidden] {
  display: none;
}
button:disabled {
  opacity: 0.5;
  cursor: default;
}
button:focus-visible,
input:focus-visible,
.request-body:focus-visible {
  outline: 2px solid var(--ar-accent-blue);
  outline-offset: 3px;
}
.request {
  position: sticky;
  top: 5.5rem;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto auto;
  max-height: calc(100dvh - 15rem);
  gap: 1rem;
  padding-top: clamp(1.25rem, 2.5vw, 2rem);
}
.request[data-state='empty'] {
  grid-template-rows: auto;
  max-height: none;
}
.request[data-state='empty'] .request-heading {
  padding: 0.9rem 1rem;
  border-left: 2px solid var(--ar-accent-violet);
  background: var(--ar-bg-subtle);
}
.request [hidden] {
  display: none;
}
.request-heading,
.request-notes {
  display: grid;
  gap: 0.4rem;
}
.request-heading h2 {
  font-size: 1.1rem;
}
.request-heading .request-label {
  color: var(--ar-accent-violet);
  font-size: 0.62rem;
  font-weight: 750;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}
.request-heading p {
  max-width: 34rem;
  font-size: 0.88rem;
}
.request-body {
  overflow: auto;
  padding: 1rem 1.1rem;
  border: 1px solid var(--ar-border);
  border-radius: 0.4rem;
  background: var(--ar-bg-subtle);
}
pre {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font-family: 'Fira Code Variable', ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 0.9rem;
  line-height: 1.75;
}
.request-notes {
  font-size: 0.85rem;
  line-height: 1.6;
}
@media (max-width: 78rem) and (min-width: 60.01rem) {
  .setup-columns {
    grid-template-columns: minmax(10rem, 0.45fr) minmax(20rem, 1fr);
    row-gap: 2rem;
  }
  .setup-stages {
    grid-row: 1 / span 2;
  }
  form {
    grid-column: 2;
  }
  .request {
    position: static;
    grid-column: 2;
    grid-row: 2;
    max-height: none;
    grid-template-rows: auto;
    padding-top: 0;
  }
}
@media (max-width: 60rem), (max-height: 42rem) {
  .request {
    position: static;
    max-height: none;
    grid-template-rows: auto;
    padding-top: 0;
  }
  form {
    padding-top: 0;
  }
  .setup-columns {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }
  .setup-stages {
    position: static;
    order: -1;
    padding-top: 0;
  }
  .setup-stages ol {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
  }
}
</style>
