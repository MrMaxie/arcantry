---
const questions = [
  {
    key: 'm',
    title: 'What do you need?',
    options: [
      ['evaluate', 'Evaluate without changes'],
      ['new', 'Set up this project'],
      ['existing', 'Adapt an existing setup'],
    ],
  },
  {
    key: 'i',
    title: 'Is the CLI available?',
    options: [
      ['yes', 'Yes'],
      ['no', 'No, work from source files'],
      ['unsure', 'Let the agent check'],
    ],
  },
  {
    key: 'r',
    title: 'Does the project use Git?',
    options: [
      ['yes', 'Yes'],
      ['no', 'No'],
      ['no-github', 'No GitHub remote'],
      ['unsure', 'Let the agent check'],
    ],
  },
  {
    key: 'g',
    title: 'Would local Git help?',
    options: [
      ['no', 'Continue without Git'],
      ['explain', 'Explain it before I decide'],
      ['yes', 'Propose local Git setup'],
    ],
  },
  {
    key: 's',
    title: 'Who needs the configuration?',
    options: [
      ['private', 'Only me'],
      ['shared', 'Project collaborators'],
      ['external', 'Keep the project unchanged'],
      ['recommend', 'Recommend the smallest useful setup'],
    ],
  },
  {
    key: 'c',
    title: 'What needs attention?',
    options: [
      ['sources', 'Knowledge sources'],
      ['guidance', 'Agent instructions'],
      ['boundaries', 'Private and shared boundaries'],
      ['repair', 'Drifting setup'],
      ['unsure', 'Let inspection decide'],
    ],
  },
  {
    key: 'x',
    title: 'How far should the agent go?',
    options: [
      ['plan', 'Inspect and prepare a plan'],
      ['apply', 'Prepare changes for my approval'],
    ],
  },
];
---

<arcantry-configurator class="not-content">
  <header class="setup-intro">
    <h1>Give your agent a useful starting point.</h1>
    <p>Choose your situation. Review the request, then copy it into your agent. Nothing here changes your project.</p>
  </header>
  <div class="setup-columns">
    <form>
      <div class="section-heading">
        <h2>Your setup</h2>
        <button type="reset">Reset choices</button>
      </div>
      {questions.map((question, index) => (
        <fieldset data-question={question.key} hidden={index > 0}>
          <legend>{question.title}</legend>
          <div class="options">
            {question.options.map(([value, label]) => (
              <label><input type="radio" name={question.key} value={value} />{label}</label>
            ))}
          </div>
        </fieldset>
      ))}
    </form>
    <section class="request" aria-labelledby="request-title">
      <div class="request-heading">
        <h2 id="request-title">Your agent request</h2>
        <p data-status role="status">Choose your goal to start.</p>
      </div>
      <!-- biome-ignore lint/a11y/noNoninteractiveTabindex: The scrollable request must be reachable for keyboard scrolling. -->
      <section class="request-body" aria-label="Generated agent request" tabindex="0">
        <pre data-prompt>Your request will appear here.</pre>
      </section>
      <div class="request-actions">
        <button type="button" data-copy disabled>Copy request</button>
      </div>
      <div class="request-notes">
        <p>Choices stay in this page's URL. No account, cookies or upload.</p>
        <a href="/getting-started/">Read the three-command workflow</a>
      </div>
    </section>
  </div>
</arcantry-configurator>

<script>
class ArcantryConfigurator extends HTMLElement {
  private startedEmpty = true;
  private abort?: AbortController;
  private value(key: string): string {
    return this.querySelector<HTMLInputElement>(`input[name="${key}"]:checked`)?.value ?? '';
  }
  connectedCallback() {
    this.abort = new AbortController();
    const options = { signal: this.abort.signal };
    this.restore();
    this.startedEmpty = !this.querySelector('input:checked');
    this.querySelector('form')?.addEventListener('change', () => this.render(), options);
    this.querySelector('form')?.addEventListener(
      'reset',
      (event) => {
        event.preventDefault();
        for (const input of this.querySelectorAll<HTMLInputElement>('input')) input.checked = false;
        this.render();
      },
      options,
    );
    this.querySelector('[data-copy]')?.addEventListener(
      'click',
      async () => {
        const prompt = this.querySelector('[data-prompt]')?.textContent ?? '';
        try {
          await navigator.clipboard.writeText(prompt);
          this.status('Request copied.');
        } catch {
          this.status('Copy is unavailable. Select and copy the request below.');
        }
      },
      options,
    );
    window.addEventListener('popstate', () => this.restore(), options);
    window.addEventListener(
      'beforeunload',
      (event) => {
        if (this.startedEmpty && this.querySelector('input:checked')) {
          event.preventDefault();
          event.returnValue = '';
        }
      },
      options,
    );
    document.addEventListener(
      'astro:before-preparation',
      (event) => {
        if (this.startedEmpty && this.querySelector('input:checked') && !window.confirm('Leave your setup choices?'))
          event.preventDefault();
      },
      options,
    );
  }
  disconnectedCallback() {
    this.abort?.abort();
  }
  private status(text: string) {
    const status = this.querySelector('[data-status]');
    if (status) status.textContent = text;
  }
  private restore() {
    const params = new URL(location.href).searchParams;
    for (const input of this.querySelectorAll<HTMLInputElement>('input')) {
      input.checked = params.get(input.name) === input.value;
    }
    this.render();
  }
  private render() {
    let reachable = true;
    const mode = this.value('m');
    for (const field of this.querySelectorAll<HTMLFieldSetElement>('fieldset')) {
      const key = field.dataset.question ?? '';
      const relevant =
        (key !== 'g' || ['no', 'no-github'].includes(this.value('r'))) &&
        (key !== 'c' || mode === 'existing') &&
        (key !== 'x' || mode !== 'evaluate');
      field.hidden = !reachable || !relevant;
      if (field.hidden) {
        for (const input of field.querySelectorAll<HTMLInputElement>('input')) input.checked = false;
      } else if (!this.value(key)) reachable = false;
    }
    const url = new URL(location.href);
    // Only known, applicable answers survive normalization, including old URLs.
    url.search = '';
    for (const input of this.querySelectorAll<HTMLInputElement>('input:checked'))
      url.searchParams.set(input.name, input.value);
    history.replaceState(null, '', url);
    const installed = this.value('i');
    const scope = this.value('s');
    const lines = [
      mode === 'existing'
        ? 'Inspect the existing Arcantry setup before proposing changes.'
        : mode === 'new'
          ? 'Help me adopt only the useful parts of Arcantry in this project.'
          : 'Evaluate whether Arcantry would help this project. Do not change files.',
      installed === 'no'
        ? 'Work directly from project source files. CLI installation is not a prerequisite.'
        : 'If Arcantry is available, run arcantry context, arcantry next, and arcantry explain tasks. If it is missing, continue from project source files.',
      'Read AGENTS.md, the selected Arcantry configuration, OpenSpec configuration and the selected change tasks and schema templates. Preserve existing work and project conventions. Report conflicts and missing facts without inventing permission.',
    ];
    if (this.value('r') === 'yes')
      lines.push('Preserve the existing Git repository and all tracked and untracked work.');
    if (this.value('r') === 'no-github') lines.push('Do not create or connect a remote. GitHub is not required.');
    if (this.value('g') === 'no') lines.push('Continue without Git.');
    if (['yes', 'explain'].includes(this.value('g')))
      lines.push('Explain the value of local Git and propose initialization separately; do not initialize it yet.');
    if (scope === 'private')
      lines.push(
        'Keep configuration private in .local, excluded through .git/info/exclude when Git is present. Never promote private content implicitly.',
      );
    if (scope === 'shared')
      lines.push('Propose shared configuration only for information collaborators need. Keep private context private.');
    if (scope === 'external')
      lines.push('Keep the target project unchanged; propose external configuration only if useful.');
    if (scope === 'recommend') lines.push('Recommend the smallest useful scope based on the inspected sources.');
    if (this.value('c')) lines.push(`Focus inspection on: ${this.value('c')}.`);
    lines.push(
      mode === 'evaluate' || this.value('x') !== 'apply' || !reachable
        ? 'Inspect and recommend only. Do not install, initialize or modify anything.'
        : 'Prepare one exact preview of the proposed changes for my approval. Apply only after that approval, then verify the result.',
    );
    lines.push(
      'Implementation, commit, deployment and release are separate decisions. Finish with the next useful action and its required format.',
    );
    const prompt = this.querySelector('[data-prompt]');
    if (prompt) prompt.textContent = mode ? lines.join('\n\n') : 'Your request will appear here.';
    const copy = this.querySelector<HTMLButtonElement>('[data-copy]');
    if (copy) copy.disabled = !mode;
    this.status(
      reachable
        ? 'Ready to copy. Review the request below.'
        : mode
          ? 'Answer the next question. The current request permits inspection only.'
          : 'Choose your goal to start.',
    );
  }
}
if (!customElements.get('arcantry-configurator')) customElements.define('arcantry-configurator', ArcantryConfigurator);
</script>

<style>
arcantry-configurator {
  display: block;
  color: var(--ar-text);
}
h1,
h2,
p,
pre {
  margin: 0;
}
.setup-intro {
  display: grid;
  gap: 1rem;
  max-width: 50rem;
  margin-bottom: 2.5rem;
}
h1 {
  font-size: clamp(2rem, 4vw, 2.5rem);
  line-height: 1.2;
  letter-spacing: -0.035em;
}
h2 {
  font-size: 1.25rem;
  line-height: 1.4;
}
p {
  color: var(--ar-text-muted);
  line-height: 1.6;
}
.setup-columns {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: clamp(2rem, 4vw, 3rem);
  align-items: start;
}
form,
.request {
  min-width: 0;
}
form {
  display: grid;
  gap: 2rem;
  padding-top: clamp(1.25rem, 2.5vw, 2rem);
}
.section-heading {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem 1rem;
}
fieldset {
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
}
fieldset[hidden] {
  display: none;
}
legend {
  padding: 0;
  margin-bottom: 0.75rem;
  font-weight: 650;
  line-height: 1.5;
}
.options {
  display: grid;
  gap: 0.5rem;
}
label {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  min-height: 3rem;
  padding: 0.75rem 1rem;
  border: 1px solid var(--ar-border);
  border-radius: 0.4rem;
  line-height: 1.5;
  cursor: pointer;
}
input {
  flex: 0 0 auto;
  width: 1rem;
  height: 1rem;
  margin: 0;
  accent-color: var(--ar-accent-blue);
}
label:hover,
button:not(:disabled):hover {
  background: var(--ar-surface);
  border-color: var(--ar-text-muted);
}
label:has(input:checked) {
  background: var(--ar-surface);
  border-color: var(--ar-accent-blue);
}
button {
  min-height: 2.75rem;
  padding: 0.65rem 1rem;
  border: 1px solid var(--ar-border);
  border-radius: 0.4rem;
  background: var(--ar-surface);
  color: var(--ar-text);
  font: inherit;
  font-weight: 650;
  line-height: 1.4;
  cursor: pointer;
}
button[type='reset'] {
  background: transparent;
  font-size: 0.85rem;
  font-weight: 400;
}
button:disabled {
  opacity: 0.5;
  cursor: default;
}
button:focus-visible,
input:focus-visible,
.request-body:focus-visible {
  outline: 2px solid var(--ar-accent-blue);
  outline-offset: 3px;
}
.request {
  position: sticky;
  top: 5.5rem;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto auto;
  max-height: calc(100dvh - 15rem);
  gap: 1.5rem;
  padding: clamp(1.25rem, 2.5vw, 2rem);
  border: 1px solid var(--ar-border);
  border-radius: 0.5rem;
  background: var(--ar-bg-subtle);
}
.request-heading,
.request-notes {
  display: grid;
  gap: 0.75rem;
}
.request-heading h2 {
  display: flex;
  align-items: center;
  min-height: 2.75rem;
}
.request-body {
  overflow: auto;
  padding-block: 1.5rem;
  border-block: 1px solid var(--ar-border);
}
pre {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font: 0.9rem / 1.75 var(--ar-font-sans);
}
.request-notes {
  font-size: 0.85rem;
  line-height: 1.6;
}
@media (max-width: 60rem), (max-height: 42rem) {
  .request {
    position: static;
    max-height: none;
    grid-template-rows: auto;
  }
  form {
    padding-top: 0;
  }
  .setup-columns {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }
}
</style>
