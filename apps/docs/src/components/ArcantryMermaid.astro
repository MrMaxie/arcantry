---
import { renderMermaidSVG } from 'beautiful-mermaid';

interface Props {
  diagram: string;
  label: string;
}

const { diagram, label } = Astro.props;
const svg = renderMermaidSVG(diagram, {
  bg: 'var(--ar-bg)',
  fg: 'var(--ar-text)',
  line: 'var(--ar-accent-violet)',
  accent: 'var(--ar-accent-pink)',
  muted: 'var(--ar-text-muted)',
  surface: 'var(--ar-bg-subtle)',
  border: 'var(--ar-border)',
  font: 'Manrope Variable',
  padding: 24,
  nodeSpacing: 32,
  layerSpacing: 32,
  componentSpacing: 32,
  transparent: true,
}).replace(/@import url\([^;]+;\s*/, '');
---

<div class="arcantry-mermaid" role="img" aria-label={label} set:html={svg}></div>

<style>
.arcantry-mermaid {
  display: grid;
  place-items: center;
  width: 100%;
  margin-block: 1.25rem 1.5rem;
  padding: 1rem;
  overflow-x: auto;
  border: 1px solid var(--ar-border);
  border-radius: 0.25rem;
  background: color-mix(in srgb, var(--ar-bg-subtle) 74%, transparent);
}

.arcantry-mermaid :global(svg) {
  display: block;
  width: min(100%, 52rem);
  min-width: 34rem;
  height: auto;
}

@media (max-width: 49.99rem) {
  .arcantry-mermaid {
    place-items: start;
    padding: 0.75rem;
  }
}
</style>
