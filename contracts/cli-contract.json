{
  "version": 2,
  "evidencePolicy": {
    "idFormat": "<command-evidence>:<dimension>",
    "requiredDimensions": ["help", "invalid", "success"],
    "mutationDimensions": ["preview", "apply", "rejection-or-rollback"],
    "mutatingCommands": [
      "repo apply",
      "repo detach",
      "repo init",
      "repo update",
      "repo remove",
      "todo add",
      "todo complete",
      "todo move",
      "todo defer",
      "todo resume",
      "release baseline",
      "release cut",
      "release render",
      "skills apply",
      "skills link",
      "skills unlink"
    ]
  },
  "provenance": {
    "appliesTo": "all-commands-and-trust-claims",
    "requirement": "openspec/specs/cli/spec.md",
    "documentation": "apps/docs/src/content/docs/reference/cli.md",
    "evidence": "crates/arcantry-cli/tests/cli_contract.rs"
  },
  "globalOptions": [
    {
      "syntax": "--cwd <path>",
      "evidence": "configuration-discovery"
    },
    {
      "syntax": "--config <path>",
      "evidence": "explicit-configuration"
    },
    {
      "syntax": "-h, --help",
      "evidence": "root-help"
    },
    {
      "syntax": "-V, --version",
      "evidence": "root-version"
    },
    {
      "syntax": "--output <path>",
      "evidence": "saved-plan"
    }
  ],
  "commands": [
    {
      "path": "context",
      "syntax": "context [--detailed] [--json]",
      "evidence": "context"
    },
    {
      "path": "next",
      "syntax": "next [--change <id>] [--json]",
      "evidence": "next"
    },
    {
      "path": "explain",
      "syntax": "explain <topic> [--json]",
      "evidence": "explain"
    },
    {
      "path": "mcp",
      "syntax": "mcp",
      "evidence": "mcp"
    },
    {
      "path": "repo inspect",
      "syntax": "repo inspect [--detailed|--json]",
      "evidence": "repo-inspect"
    },
    {
      "path": "repo plan",
      "syntax": "repo plan --source <id> --transition <strategy> [--to-path <path>] [--to-adapter <adapter>] [--from <source...>] [--managed-from <version>] [--delete-source] [--json]",
      "evidence": "repo-plan"
    },
    {
      "path": "repo apply",
      "syntax": "repo apply --plan <path|-> [--allow-outside <path>...]",
      "evidence": "repo-apply"
    },
    {
      "path": "repo detach",
      "syntax": "repo detach [--capability <id>...] [--apply] [--json]",
      "evidence": "repo-detach"
    },
    {
      "path": "repo init",
      "syntax": "repo init --scope <shared|private> [--compat claude]",
      "evidence": "repo-init"
    },
    {
      "path": "repo update",
      "syntax": "repo update --scope <shared|private> [--compat claude]",
      "evidence": "repo-update"
    },
    {
      "path": "repo doctor",
      "syntax": "repo doctor",
      "evidence": "repo-doctor"
    },
    {
      "path": "repo validate",
      "syntax": "repo validate",
      "evidence": "repo-validate"
    },
    {
      "path": "repo remove",
      "syntax": "repo remove --scope <shared|private>",
      "evidence": "repo-remove"
    },
    {
      "path": "todo list",
      "syntax": "todo list [--source <id>] [--json]",
      "evidence": "todo-list"
    },
    {
      "path": "todo add",
      "syntax": "todo add <task> [--source <id>] [--apply]",
      "evidence": "todo-add"
    },
    {
      "path": "todo complete",
      "syntax": "todo complete <line> [--source <id>] [--date <YYYY-MM-DD>] [--apply]",
      "evidence": "todo-complete"
    },
    {
      "path": "todo move",
      "syntax": "todo move <line> --from <id> --to <id> [--apply]",
      "evidence": "todo-move"
    },
    {
      "path": "todo defer",
      "syntax": "todo defer <line> --source <id> [--until <YYYY-MM-DD>] [--wait <slug>] [--apply]",
      "evidence": "todo-defer"
    },
    {
      "path": "todo resume",
      "syntax": "todo resume <line> --source <id> [--apply]",
      "evidence": "todo-resume"
    },
    {
      "path": "release baseline",
      "syntax": "release baseline <version> --date <YYYY-MM-DD> [--unit <id>] [--apply] [--json]",
      "evidence": "release-baseline"
    },
    {
      "path": "release plan",
      "syntax": "release plan [--unit <id>] [--json]",
      "evidence": "release-plan"
    },
    {
      "path": "release cut",
      "syntax": "release cut [--date <YYYY-MM-DD>] [--unit <id>] [--apply] [--json]",
      "evidence": "release-cut"
    },
    {
      "path": "release render",
      "syntax": "release render [--unit <id>] [--apply] [--json]",
      "evidence": "release-render"
    },
    {
      "path": "release check",
      "syntax": "release check [--unit <id>] [--sealed]",
      "evidence": "release-check"
    },
    {
      "path": "skills list",
      "syntax": "skills list [--scope <public|private>] [--catalog-root <path>]",
      "evidence": "skills-list"
    },
    {
      "path": "skills inspect",
      "syntax": "skills inspect <name> [--scope <public|private>] [--catalog-root <path>]",
      "evidence": "skills-inspect"
    },
    {
      "path": "skills status",
      "syntax": "skills status [<name>] [--scope <user|repo>] [--target <path>] [--catalog-root <path>] [--check] [--json]",
      "evidence": "skills-status"
    },
    {
      "path": "skills update",
      "syntax": "skills update <name> [--scope <user|repo>] [--target <path>] [--catalog-root <path>] [--compat claude]",
      "evidence": "skills-update"
    },
    {
      "path": "skills apply",
      "syntax": "skills apply --plan <path|->",
      "evidence": "skills-apply"
    },
    {
      "path": "skills link",
      "syntax": "skills link <name> (--scope <user|repo|private> [--compat claude] | --target <path>) [--replace]",
      "evidence": "skills-link"
    },
    {
      "path": "skills unlink",
      "syntax": "skills unlink <name> (--scope <user|repo|private> [--compat claude] | --target <path>)",
      "evidence": "skills-unlink"
    },
    {
      "path": "skills doctor",
      "syntax": "skills doctor [--scope <user|repo|private>] [--compat claude] [--target <path>] [--catalog-root <path>]",
      "evidence": "skills-doctor"
    },
    {
      "path": "diagnostics",
      "syntax": "diagnostics",
      "evidence": "diagnostics"
    },
    {
      "path": "repo recover",
      "syntax": "repo recover [--acknowledge]",
      "evidence": "repo-recover"
    }
  ],
