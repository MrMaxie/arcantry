{
  "version": 1,
  "globalOptions": [
    { "syntax": "--cwd <path>", "evidence": "configuration-discovery" },
    { "syntax": "--config <path>", "evidence": "explicit-configuration" },
    { "syntax": "-h, --help", "evidence": "root-help" },
    { "syntax": "-V, --version", "evidence": "root-version" }
  ],
  "commands": [
    { "path": "repo inspect", "syntax": "repo inspect [--json]", "evidence": "repo-inspect" },
    { "path": "repo plan", "syntax": "repo plan --source <id> --transition <strategy> [--to-path <path>] [--to-adapter <adapter>] [--from <source...>] [--managed-from <version>] [--delete-source] [--json]", "evidence": "repo-plan" },
    { "path": "repo apply", "syntax": "repo apply --plan <path|-> [--allow-outside <path>...]", "evidence": "repo-apply" },
    { "path": "repo init", "syntax": "repo init --scope <shared|private> [--compat claude]", "evidence": "repo-init" },
    { "path": "repo update", "syntax": "repo update --scope <shared|private> [--compat claude]", "evidence": "repo-update" },
    { "path": "repo doctor", "syntax": "repo doctor", "evidence": "repo-doctor" },
    { "path": "repo validate", "syntax": "repo validate", "evidence": "repo-validate" },
    { "path": "repo remove", "syntax": "repo remove --scope <shared|private>", "evidence": "repo-remove" },
    { "path": "todo list", "syntax": "todo list [--source <id>]", "evidence": "todo-list" },
    { "path": "todo add", "syntax": "todo add <task> [--source <id>] [--apply]", "evidence": "todo-add" },
    { "path": "todo complete", "syntax": "todo complete <line> [--source <id>] [--date <YYYY-MM-DD>] [--apply]", "evidence": "todo-complete" },
    { "path": "todo move", "syntax": "todo move <line> --from <id> --to <id> [--apply]", "evidence": "todo-move" },
    { "path": "release baseline", "syntax": "release baseline <version> --date <YYYY-MM-DD> [--unit <id>] [--apply] [--json]", "evidence": "release-baseline" },
    { "path": "release plan", "syntax": "release plan [--unit <id>] [--json]", "evidence": "release-plan" },
    { "path": "release cut", "syntax": "release cut [--date <YYYY-MM-DD>] [--unit <id>] [--apply] [--json]", "evidence": "release-cut" },
    { "path": "release render", "syntax": "release render [--unit <id>] [--apply] [--json]", "evidence": "release-render" },
    { "path": "release check", "syntax": "release check [--unit <id>] [--sealed]", "evidence": "release-check" },
    { "path": "skills list", "syntax": "skills list [--scope <public|private>] [--catalog-root <path>]", "evidence": "skills-list" },
    { "path": "skills inspect", "syntax": "skills inspect <name> [--scope <public|private>] [--catalog-root <path>]", "evidence": "skills-inspect" },
    { "path": "skills link", "syntax": "skills link <name> (--scope <user|repo|private> [--compat claude] | --target <path>) [--replace]", "evidence": "skills-link" },
    { "path": "skills unlink", "syntax": "skills unlink <name> (--scope <user|repo|private> [--compat claude] | --target <path>)", "evidence": "skills-unlink" },
    { "path": "skills doctor", "syntax": "skills doctor [--scope <user|repo|private>] [--compat claude] [--target <path>] [--catalog-root <path>]", "evidence": "skills-doctor" }
  ],
  "trustClaims": [
    { "id": "inspect-read-only", "evidence": "repo-inspect-read-only" },
    { "id": "plan-read-only", "evidence": "repo-plan-read-only" },
    { "id": "apply-rejects-drift", "evidence": "repo-apply-rejects-drift" },
    { "id": "remove-owned-only", "evidence": "repo-remove-owned-only" },
    { "id": "todo-preview-first", "evidence": "todo-add-preview-first" },
    { "id": "release-local-only", "evidence": "release-check-local-only" }
  ],
  "scenarios": [
    { "id": "configuration-discovery", "command": "arcantry" },
    { "id": "explicit-configuration", "command": "arcantry" },
    { "id": "root-help", "command": "arcantry" },
    { "id": "root-version", "command": "arcantry" },
    { "id": "repo-inspect", "command": "repo inspect" },
    { "id": "repo-plan", "command": "repo plan" },
    { "id": "repo-apply", "command": "repo apply" },
    { "id": "repo-init", "command": "repo init" },
    { "id": "repo-update", "command": "repo update" },
    { "id": "repo-doctor", "command": "repo doctor" },
    { "id": "repo-validate", "command": "repo validate" },
    { "id": "repo-remove", "command": "repo remove" },
    { "id": "todo-list", "command": "todo list" },
    { "id": "todo-add", "command": "todo add" },
    { "id": "todo-complete", "command": "todo complete" },
    { "id": "todo-move", "command": "todo move" },
    { "id": "release-baseline", "command": "release baseline" },
    { "id": "release-plan", "command": "release plan" },
    { "id": "release-cut", "command": "release cut" },
    { "id": "release-render", "command": "release render" },
    { "id": "release-check", "command": "release check" },
    { "id": "skills-list", "command": "skills list" },
    { "id": "skills-inspect", "command": "skills inspect" },
    { "id": "skills-link", "command": "skills link" },
    { "id": "skills-unlink", "command": "skills unlink" },
    { "id": "skills-doctor", "command": "skills doctor" },
    { "id": "repo-inspect-read-only", "command": "repo inspect" },
    { "id": "repo-plan-read-only", "command": "repo plan" },
    { "id": "repo-apply-rejects-drift", "command": "repo apply" },
    { "id": "repo-remove-owned-only", "command": "repo remove" },
    { "id": "todo-add-preview-first", "command": "todo add" },
    { "id": "release-check-local-only", "command": "release check" }
  ]
}
