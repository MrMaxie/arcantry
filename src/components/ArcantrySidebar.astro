---
import type { StarlightIcon } from '@astrojs/starlight/types';
import { Icon } from '@astrojs/starlight/components';
import { faHeart } from '@fortawesome/free-solid-svg-icons';

const { sidebar } = Astro.locals.starlightRoute;
const [heartWidth, heartHeight, , , heartPath] = faHeart.icon;
const icons: Record<string, StarlightIcon> = {
  Homepage: 'rocket',
  'Get started': 'approve-check',
  Adoption: 'approve-check',
  'Adoption paths': 'approve-check',
  Skills: 'puzzle',
  'Skill catalog': 'list-format',
  'Catalog overview': 'list-format',
  CLI: 'setting',
  Configuration: 'setting',
  'Inspect, plan and apply': 'code-branch',
  'todo.txt queues': 'list-format',
  'Project knowledge stack': 'document',
  'Change lifecycle': 'document',
  'Release lifecycle': 'star',
  'Contributor commands': 'open-book',
  'Adopt Arcantry': 'rocket',
  'Agent Self Improve': 'setting',
  'Audit Skill Portfolio': 'list-format',
  'Capture Repeatable Work': 'document',
  'Evaluate Skill Change': 'approve-check',
  'Forge Skill from Conversations': 'puzzle',
  'Productize Repeatable Work': 'code-branch',
  'Select Task Skills': 'list-format',
  'Audience and Scope Discipline': 'document',
  'Design Terminal UX': 'setting',
  'Intake Linear Work': 'document',
  'Intake Repository Work': 'code-branch',
  'Promote Meeting Notes': 'open-book',
  'Stage Code Review Findings': 'approve-check',
};
const iconFor = (label: string): StarlightIcon => icons[label] ?? 'document';
---

<div class="navigation">
  {sidebar.map((entry) => (
    entry.type === 'link' ? (
      <a class:list={['nav-link', { active: entry.isCurrent }]} href={entry.href} aria-current={entry.isCurrent ? 'page' : undefined}>
        <span class="nav-icon-slot" aria-hidden="true">
          <Icon name={iconFor(entry.label)} />
        </span>
        <span>{entry.label}</span>
      </a>
    ) : (
      <section class="nav-group">
        <div class="nav-label">{entry.label}</div>
        <div class="nav-items">
          {entry.entries.map((item) => item.type === 'link' ? (
            <a class:list={['nav-link', { active: item.isCurrent }]} href={item.href} aria-current={item.isCurrent ? 'page' : undefined}>
              <span class="nav-icon-slot" aria-hidden="true"><Icon name={iconFor(item.label)} /></span>
              <span>{item.label}</span>
            </a>
          ) : (
            <details class="nav-subgroup" open={!item.collapsed || item.entries.some((child) => child.type === 'link' && child.isCurrent)}>
              <summary>
                <span class="nav-icon-slot" aria-hidden="true"><Icon name={iconFor(item.label)} /></span>
                <span>{item.label}</span>
                <Icon class="nav-caret" name="right-caret" aria-hidden="true" />
              </summary>
              <div class="nav-subitems">
                {item.entries.map((child) => child.type === 'link' && (
                  <a class:list={['nav-link', 'nav-sublink', { active: child.isCurrent }]} href={child.href} aria-current={child.isCurrent ? 'page' : undefined}>
                    <span class="nav-icon-slot" aria-hidden="true"><Icon name={iconFor(child.label)} /></span>
                    <span>{child.label}</span>
                  </a>
                ))}
              </div>
            </details>
          ))}
        </div>
      </section>
    )
  ))}
</div>

<div class="sidebar-foot">
  <span class="sidebar-credit">
    Created with <span class="sr-only">love </span>
    <span class="sidebar-heart" aria-hidden="true">
      <svg viewBox={`0 0 ${heartWidth} ${heartHeight}`}><path d={heartPath as string} /></svg>
    </span>
    by Maxie
  </span>
</div>

<style>
  @layer starlight.core {
    :global(.arcantry-sidebar-pane) { padding: 0; display: flex; flex-direction: column; }
    .navigation { flex: 1; padding: 1.5rem .9rem 2rem; }
    .nav-group + .nav-group, .nav-link + .nav-group { margin-top: 1.7rem; }
    .nav-label { padding: 0 .7rem .5rem; color: var(--ar-text-soft); font-size: .68rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
    .nav-items { display: grid; gap: .1rem; }
    .nav-link {
      display: flex;
      align-items: center;
      gap: .65rem;
      margin-inline: -.9rem;
      padding: .5rem .9rem .5rem 1.6rem;
      border-left: 2px solid transparent;
      color: var(--ar-text-muted);
      text-decoration: none;
      font-size: .83rem;
      font-weight: 560;
      letter-spacing: -.015em;
      transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease;
    }
    .nav-icon-slot { display: grid; width: .9rem; flex: 0 0 .9rem; place-items: center; }
    .nav-link :global(svg) { flex: 0 0 auto; color: var(--ar-text-soft); font-size: .9rem; transition: color 150ms ease; }
    .nav-link:hover { color: var(--ar-text); background: var(--ar-surface); }
    .nav-link:hover :global(svg) { color: var(--ar-accent-blue); }
    .nav-link.active :global(svg) { color: var(--ar-accent-violet); }
    .nav-link.active {
      color: var(--ar-text);
      border-left-color: var(--ar-accent-violet);
      background: linear-gradient(90deg, color-mix(in srgb, var(--ar-accent-violet) 9%, transparent), transparent 82%);
    }
    .nav-subgroup { margin-inline: -.9rem; }
    :global(.nav-subgroup > summary) {
      display: flex;
      align-items: center;
      gap: .65rem;
      padding: .5rem .9rem .5rem 1.6rem;
      color: var(--ar-text-muted);
      cursor: pointer;
      font-size: .83rem;
      font-weight: 560;
      letter-spacing: -.015em;
      list-style: none;
      transition: color 150ms ease, background-color 150ms ease;
    }
    :global(.nav-subgroup > summary::-webkit-details-marker),
    :global(.nav-subgroup > summary::marker) { content: ''; display: none; }
    :global(.nav-subgroup > summary:hover) { color: var(--ar-text); background: var(--ar-surface); }
    :global(.nav-subgroup > summary svg) { color: var(--ar-text-soft); font-size: .9rem; transition: color 150ms ease, transform 150ms ease; }
    :global(.nav-subgroup > summary:hover svg) { color: var(--ar-accent-blue); }
    :global(.nav-subgroup[open] > summary) { color: var(--ar-text); }
    :global(.nav-subgroup[open] > summary > .nav-caret) { transform: rotate(90deg); }
    .nav-subitems { display: grid; gap: .08rem; padding-bottom: .2rem; }
    .nav-sublink { margin-inline: 0; padding-left: 2.75rem; font-size: .78rem; }
    .sidebar-foot { display: flex; align-items: center; min-height: 3.25rem; padding: .8rem 1.35rem; border-top: 1px solid var(--ar-border); color: var(--ar-text-soft); font-size: .65rem; }
    .sidebar-credit { display: inline-flex; align-items: center; gap: .26rem; }
    .sidebar-heart {
      position: relative;
      display: inline-grid;
      place-items: center;
      width: .9rem;
      height: .9rem;
      flex: 0 0 auto;
      color: var(--ar-heart);
    }
    .sidebar-heart::before {
      content: '';
      position: absolute;
      inset: -.35rem;
      border-radius: 50%;
      background: radial-gradient(circle, color-mix(in srgb, var(--ar-heart) 34%, transparent), transparent 68%);
      filter: blur(3px);
      opacity: .65;
      animation: sidebar-heart-glow 1.8s ease-in-out infinite;
    }
    .sidebar-heart svg {
      position: relative;
      width: .72rem;
      height: .72rem;
      fill: currentColor;
      animation: sidebar-heart-pulse 1.8s ease-in-out infinite;
      transform-origin: center;
      will-change: transform;
    }
    @keyframes sidebar-heart-pulse {
      0%, 100% { transform: scale(1); }
      14% { transform: scale(1.24); }
      28% { transform: scale(1.04); }
      42% { transform: scale(1.18); }
      58% { transform: scale(1); }
    }
    @keyframes sidebar-heart-glow {
      0%, 100% { opacity: .45; transform: scale(.82); }
      22% { opacity: .9; transform: scale(1.12); }
      48% { opacity: .58; transform: scale(.94); }
    }
    @media (prefers-reduced-motion: reduce) {
      .sidebar-heart::before,
      .sidebar-heart svg { animation: none; }
    }
  }
</style>
