---
import type {} from '@astrojs/starlight';
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';
import ArcantryCopyCommands from './ArcantryCopyCommands.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class:list={['arcantry-page', { 'has-sidebar': hasSidebar }]}>
  <ArcantryCopyCommands />
  <header class="arcantry-header" transition:persist><slot name="header" /></header>
  {hasSidebar && (
    <nav class="arcantry-sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
      <MobileMenuToggle />
      <div id="starlight__sidebar" class="arcantry-sidebar-pane" transition:name="arcantry-sidebar">
        <slot name="sidebar" />
      </div>
    </nav>
  )}
  <div class="arcantry-main-frame"><slot /></div>
</div>

<style>
  @layer starlight.core {
    .arcantry-page { min-height: 100vh; background: var(--ar-bg); }
    .arcantry-header {
      position: fixed;
      z-index: var(--sl-z-index-navbar);
      inset: 0 0 auto 0;
      height: var(--sl-nav-height);
      border-bottom: 1px solid var(--ar-border);
      background: color-mix(in srgb, var(--ar-bg) 84%, transparent);
      -webkit-backdrop-filter: blur(16px) saturate(112%);
      backdrop-filter: blur(16px) saturate(112%);
    }
    .arcantry-header::after {
      content: '';
      position: absolute;
      inset: auto 0 -1px;
      height: 2px;
      pointer-events: none;
      background: linear-gradient(90deg, var(--ar-accent-blue), var(--ar-accent-violet) 52%, var(--ar-accent-pink));
      box-shadow: 0 0 1.1rem color-mix(in srgb, var(--ar-accent-violet) 40%, transparent);
      opacity: 0;
      transform: scaleX(.08);
      transform-origin: left;
      transition: opacity 120ms ease, transform 700ms cubic-bezier(.16, 1, .3, 1);
    }
    :global(html[data-navigation-pending='true']) .arcantry-header::after {
      opacity: .9;
      transform: scaleX(.78);
    }
    :global(html[data-navigation-ready='true']) .arcantry-header::after {
      opacity: .9;
      transform: scaleX(1);
      transition-duration: 120ms;
    }
    .arcantry-sidebar-pane {
      visibility: var(--sl-sidebar-visibility, hidden);
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset: var(--sl-nav-height) 0 0 0;
      overflow-y: auto;
      background: var(--ar-bg-subtle);
      border-right: 1px solid var(--ar-border);
    }
    :global([aria-expanded='true']) ~ .arcantry-sidebar-pane { --sl-sidebar-visibility: visible; }
    .arcantry-main-frame {
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
    }

    @media (min-width: 50rem) {
      .arcantry-page.has-sidebar .arcantry-sidebar-pane {
        --sl-sidebar-visibility: visible;
        inset: var(--sl-nav-height) auto 0 0;
        width: var(--sl-sidebar-width);
      }
      .arcantry-page.has-sidebar .arcantry-main-frame { padding-inline-start: var(--sl-sidebar-width); }
    }

    @media (prefers-reduced-motion: reduce) {
      .arcantry-header::after { transition: none; }
    }
  }
</style>
