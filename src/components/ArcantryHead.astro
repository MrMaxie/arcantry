---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';
---

<DefaultHead />
<ClientRouter fallback="animate" />

<script>
  import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';

  const root = document.documentElement;
  let navigationReset = 0;

  document.addEventListener('astro:before-preparation', () => {
    window.clearTimeout(navigationReset);
    delete root.dataset.navigationReady;
    root.dataset.navigationPending = 'true';
  });

  document.addEventListener('astro:after-preparation', () => {
    delete root.dataset.navigationPending;
    root.dataset.navigationReady = 'true';
  });

  document.addEventListener('astro:before-swap', (event) => {
    const transition = event as TransitionBeforeSwapEvent;
    transition.newDocument.documentElement.dataset.theme = root.dataset.theme ?? 'dark';
  });

  document.addEventListener('astro:page-load', () => {
    navigationReset = window.setTimeout(() => {
      delete root.dataset.navigationReady;
    }, 180);
  });
</script>
