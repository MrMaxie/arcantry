---
import Search from '@astrojs/starlight/components/Search.astro';
import { Icon } from '@astrojs/starlight/components';
import mark from '../assets/arcantry-mark.svg';
import wordmark from '../assets/arcantry-wordmark-approved.svg';
import { buildVersionModel } from '../../tooling/version.js';

const { currentRelease } = buildVersionModel();
---

<div class="header-shell">
  <a class="brand-lockup" href="/arcantry/" aria-label="Arcantry home" transition:name="arcantry-brand">
    <span class="brand-art" aria-hidden="true">
      <img class="brand-wordmark" src={wordmark.src} alt="" />
      <img class="brand-symbol" src={mark.src} alt="" />
    </span>
    <span class="brand-version">v{currentRelease}</span>
  </a>
  <div class="header-search" transition:name="arcantry-search"><Search /></div>
  <div class="header-actions" transition:name="arcantry-actions">
    <a
      class="github-link"
      href="https://github.com/MrMaxie/arcantry"
      aria-label="Arcantry on GitHub"
      title="GitHub"
    >
      <Icon name="github" />
    </a>
    <arcantry-theme-control>
      <button class="theme-button" type="button" aria-label="Change color theme" title="Change color theme">
        <span class="theme-icon theme-light">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="3.5" />
            <path d="M12 2.5v2M12 19.5v2M4.5 12h-2M21.5 12h-2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4" />
          </svg>
        </span>
        <span class="theme-icon theme-dark">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 15.2A8 8 0 0 1 8.8 4 7.2 7.2 0 1 0 20 15.2Z" />
          </svg>
        </span>
      </button>
    </arcantry-theme-control>
  </div>
</div>

<script>
  type ThemeMode = 'light' | 'dark';

  const storageKey = 'starlight-theme';
  const labels: Record<ThemeMode, string> = { light: 'Light', dark: 'Dark' };

  function readMode(): ThemeMode | null {
    const stored = localStorage.getItem(storageKey);
    return stored === 'light' || stored === 'dark' ? stored : null;
  }

  function systemTheme(): 'light' | 'dark' {
    return matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
  }

  function applyMode(mode: ThemeMode, persist = false): void {
    document.documentElement.dataset.theme = mode;
    if (persist) localStorage.setItem(storageKey, mode);
  }

  class ArcantryThemeControl extends HTMLElement {
    private mode: ThemeMode = systemTheme();
    private followsSystem = true;
    private systemPreference = matchMedia('(prefers-color-scheme: light)');

    connectedCallback(): void {
      const stored = readMode();
      this.followsSystem = stored === null;
      this.mode = stored ?? systemTheme();
      applyMode(this.mode);
      this.render();
      this.querySelector('button')?.addEventListener('click', this.onClick);
      this.systemPreference.addEventListener('change', this.onSystemThemeChange);
    }

    disconnectedCallback(): void {
      this.querySelector('button')?.removeEventListener('click', this.onClick);
      this.systemPreference.removeEventListener('change', this.onSystemThemeChange);
    }

    private onSystemThemeChange = (): void => {
      if (!this.followsSystem) return;
      this.mode = systemTheme();
      applyMode(this.mode);
      this.render();
    };

    private onClick = (): void => {
      this.followsSystem = false;
      this.mode = this.mode === 'dark' ? 'light' : 'dark';
      applyMode(this.mode, true);
      this.render();
    };

    private render(): void {
      const button = this.querySelector('button');
      if (!button) return;
      const label = `Theme: ${labels[this.mode]}`;
      const next = this.mode === 'dark' ? 'light' : 'dark';
      button.setAttribute('aria-label', `${label}. Switch to ${next} theme`);
      button.setAttribute('title', label);
      button.dataset.mode = this.mode;
    }
  }

  if (!customElements.get('arcantry-theme-control')) {
    customElements.define('arcantry-theme-control', ArcantryThemeControl);
  }
</script>

<style>
  @layer starlight.core {
    .header-shell {
      box-sizing: border-box;
      width: 100%;
      max-width: 100vw;
      margin-inline: auto;
      height: 100%;
      display: flex;
      align-items: center;
      gap: 1.25rem;
      padding: 0 1.25rem;
      transition: width 520ms cubic-bezier(.16, 1, .3, 1), max-width 520ms cubic-bezier(.16, 1, .3, 1), padding-inline 520ms cubic-bezier(.16, 1, .3, 1);
    }
    .brand-lockup {
      display: grid;
      align-content: center;
      justify-items: start;
      gap: .14rem;
      width: calc(var(--sl-sidebar-width) - 2.5rem);
      min-width: calc(var(--sl-sidebar-width) - 2.5rem);
      height: 3.2rem;
      text-decoration: none;
      color: var(--ar-text);
    }
    .brand-art { display: block; height: 1.38rem; }
    .brand-wordmark { display: block; width: 6.5rem; height: 1.38rem; object-fit: contain; object-position: left center; }
    .brand-symbol { display: none; width: 1.45rem; height: 1.38rem; object-fit: contain; }
    .brand-version { color: var(--ar-text-soft); font-size: .56rem; font-weight: 700; letter-spacing: .08em; line-height: 1; }
    .header-search { flex: 0 0 18.75rem; width: 18.75rem; min-width: 0; max-width: 18.75rem; }
    .header-actions { margin-left: auto; display: flex; align-items: center; gap: .5rem; }
    .github-link {
      width: 2rem;
      height: 2rem;
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      padding: 0;
      border: 0;
      border-radius: 0;
      color: var(--ar-text-muted);
      line-height: 0;
      transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease;
    }
    .github-link { font-size: 1rem; text-decoration: none; }
    .github-link:hover {
      color: var(--ar-text);
      background: transparent;
    }
    arcantry-theme-control { display: block; color: var(--ar-text-muted); }
    .theme-button {
      display: grid;
      place-items: center;
      width: 2rem;
      height: 2rem;
      padding: 0;
      border: 0;
      border-radius: 0;
      color: inherit;
      background: transparent;
      cursor: pointer;
      font-size: 1rem;
      line-height: 0;
      transition: color 150ms ease, background-color 150ms ease;
    }
    .theme-button:hover { color: var(--ar-text); background: transparent; }
    .theme-icon { display: none; width: 1rem; height: 1rem; place-items: center; }
    .github-link :global(svg),
    .theme-icon :global(svg),
    .theme-icon > svg { display: block; width: 1rem; height: 1rem; }
    .theme-icon > svg { fill: none; stroke: currentColor; stroke-width: 1.25; stroke-linecap: round; stroke-linejoin: round; }
    .theme-button[data-mode='light'] .theme-light,
    .theme-button[data-mode='dark'] .theme-dark { display: grid; }
    .brand-lockup:hover .brand-art,
    .brand-lockup:hover .brand-version { opacity: .72; }
    .brand-art,
    .brand-version { transition: opacity 150ms ease; }
    .brand-symbol,
    .brand-wordmark {
      filter: var(--ar-logo-filter);
    }
    .brand-lockup:focus-visible,
    .github-link:focus-visible,
    .theme-button:focus-visible,
    :global(site-search button[data-open-modal]:focus-visible) {
      outline: 2px solid var(--ar-accent-violet);
      outline-offset: 2px;
    }
    :global(site-search button[data-open-modal]) {
      max-width: none !important;
      width: 100% !important;
      height: 2.55rem !important;
      border-radius: .25rem !important;
      border-color: var(--ar-border) !important;
      background: transparent !important;
      box-shadow: none !important;
      color: var(--ar-text-muted) !important;
      font-size: .75rem !important;
    }
    :global(site-search button[data-open-modal]:hover) {
      border-color: var(--ar-text-soft) !important;
      color: var(--ar-text) !important;
    }

    :global(html[data-has-hero]) .header-shell {
      width: calc(100% - 2rem);
      max-width: 72rem;
      padding-inline: 0;
    }
    @media (max-width: 49.99rem) {
      .header-shell {
        gap: .7rem;
        padding-inline: .8rem;
      }
      .header-actions { gap: .35rem; }
      :global(.arcantry-page.has-sidebar) .header-actions { margin-inline-end: 2.45rem; }
      .brand-lockup { width: 2rem; min-width: 2rem; }
      .brand-wordmark { display: none; }
      .brand-symbol { display: block; }
      .brand-version { font-size: .48rem; letter-spacing: .02em; }
      :global(html[data-has-hero]) .header-search {
        flex: 1 1 auto;
        width: auto;
        max-width: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .header-shell { transition: none; }
    }

  }
</style>
