---
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import { Icon } from '@astrojs/starlight/components';
import mark from '../assets/arcantry-mark.svg';
---

<div class="header-shell">
  <a class="brand-mark" href="/arcantry/" aria-label="Arcantry home">
    <img src={mark.src} alt="" />
  </a>
  <div class="header-search"><Search /></div>
  <div class="header-actions">
    <a
      class="github-link"
      href="https://github.com/MrMaxie/arcantry"
      aria-label="Arcantry on GitHub"
      title="GitHub"
    >
      <Icon name="github" />
    </a>
    <div class="theme-control" title="Color theme">
      <ThemeSelect />
    </div>
  </div>
</div>

<script is:inline>
  document.querySelectorAll('starlight-theme-select option[value="auto"]').forEach((option) => {
    option.textContent = 'System';
  });
</script>

<style>
  @layer starlight.core {
    .header-shell {
      height: 100%;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0 1.25rem;
    }
    .brand-mark {
      display: grid;
      place-items: center;
      width: 2rem;
      height: 2rem;
      flex: 0 0 auto;
      text-decoration: none;
      border-radius: 999px;
    }
    .header-search { flex: 1 1 auto; min-width: 0; max-width: 44rem; }
    .header-actions { margin-left: auto; display: flex; align-items: center; gap: .5rem; }
    .github-link {
      width: 2rem;
      height: 2rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      border: 1px solid transparent;
      border-radius: 999px;
      color: var(--ar-text-muted);
    }
    .github-link { font-size: 1rem; text-decoration: none; }
    .github-link:hover {
      color: var(--ar-text);
      border-color: var(--ar-border);
      background: var(--ar-bg-subtle);
    }
    .theme-control {
      color: var(--ar-text-muted);
    }
    .theme-control :global(starlight-theme-select label) {
      height: 2rem;
      border: 1px solid var(--ar-border);
      border-radius: 999px;
      color: inherit;
    }
    .theme-control :global(starlight-theme-select label:hover) {
      color: var(--ar-text);
      border-color: var(--ar-text-soft);
      background: var(--ar-bg-subtle);
    }
    .theme-control :global(starlight-theme-select select) {
      width: 5.85rem !important;
      height: 100%;
      margin: 0 !important;
      padding-block: 0 !important;
      padding-inline: 1.55rem 1.45rem !important;
      font-size: .76rem;
      font-weight: 650;
      letter-spacing: -.01em;
    }
    .theme-control :global(starlight-theme-select .label-icon) {
      inset-inline-start: .55rem;
      font-size: .85rem;
    }
    .theme-control :global(starlight-theme-select .caret) {
      inset-inline-end: .45rem;
      font-size: .8rem;
    }
    .brand-mark:hover {
      background: var(--ar-bg-subtle);
    }
    .brand-mark:focus-visible,
    .github-link:focus-visible,
    .theme-control:has(select:focus-visible),
    :global(site-search button[data-open-modal]:focus-visible) {
      outline: 2px solid var(--ar-text);
      outline-offset: 2px;
    }
    .brand-mark img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      filter: var(--ar-logo-filter);
    }

    :global(site-search button[data-open-modal]) {
      max-width: none !important;
      width: 100% !important;
      height: 2.55rem !important;
      border-radius: .25rem !important;
      border-color: var(--ar-border) !important;
      background: transparent !important;
      box-shadow: none !important;
      color: var(--ar-text-muted) !important;
    }
    :global(site-search button[data-open-modal]:hover) {
      border-color: var(--ar-text-soft) !important;
      color: var(--ar-text) !important;
    }

    @media (max-width: 49.99rem) {
      .header-shell {
        gap: .7rem;
        padding-inline: .8rem;
      }
      .header-actions { gap: .35rem; }
    }

  }
</style>
