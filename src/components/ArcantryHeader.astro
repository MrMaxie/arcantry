---
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import mark from '../assets/arcantry-mark.svg';
---

<div class="header-shell">
  <div class="header-search"><Search /></div>
  <div class="header-actions">
    <a class="github-link" href="https://github.com/MrMaxie/arcantry" aria-label="Arcantry on GitHub">GitHub</a>
    <ThemeSelect />
    <a class="brand-mark" href="/arcantry/" aria-label="Arcantry home">
      <img src={mark.src} alt="" />
    </a>
  </div>
</div>

<style>
  @layer starlight.core {
    .header-shell {
      height: 100%;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0 1.25rem;
    }
    .header-search { flex: 1; max-width: 44rem; }
    .header-actions { margin-left: auto; display: flex; align-items: center; gap: .9rem; }
    .github-link {
      color: var(--ar-text-muted);
      font-size: .82rem;
      font-weight: 650;
      text-decoration: none;
      letter-spacing: -.01em;
    }
    .github-link:hover { color: var(--ar-text); }
    .brand-mark {
      display: grid;
      place-items: center;
      width: 2rem;
      height: 2rem;
      text-decoration: none;
    }
    .brand-mark img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      filter: var(--ar-logo-filter);
    }

    :global(site-search button[data-open-modal]) {
      max-width: none !important;
      width: 100% !important;
      height: 2.55rem !important;
      border-radius: .25rem !important;
      border-color: var(--ar-border) !important;
      background: transparent !important;
      box-shadow: none !important;
      color: var(--ar-text-muted) !important;
    }
    :global(site-search button[data-open-modal]:hover) {
      border-color: var(--ar-text-soft) !important;
      color: var(--ar-text) !important;
    }
  }
</style>
