---
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';
---

<footer class="page-footer">
  <div class="page-meta">
    <EditLink />
    <LastUpdated />
  </div>
  <div class="pagination-transition" transition:name="arcantry-next-action">
    <Pagination />
  </div>
</footer>

<style>
  @layer starlight.core {
    .page-footer { display: grid; gap: 1.1rem; }
    .page-meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: .75rem 3rem;
      margin-top: 2.25rem;
      color: var(--ar-text-soft);
      font-size: var(--sl-text-sm);
    }
    :global(.pagination-links) {
      grid-template-columns: repeat(2, minmax(0, 14rem));
      justify-content: center;
      gap: .75rem;
    }
    :global(.pagination-links:has(a:only-child)) { grid-template-columns: minmax(0, 14rem); }
    :global(.pagination-links a[rel='next']:only-child) { grid-column: 1; }
    :global(.pagination-links a) {
      min-height: 0;
      padding: .7rem .85rem;
      border-radius: .25rem;
      box-shadow: none;
    }
    :global(.pagination-links .link-title) { font-size: .92rem; line-height: 1.25; }
    :global(.pagination-links a > span:first-child) { font-size: .68rem; }
    :global(.pagination-links svg) { width: 1rem; height: 1rem; }
    .pagination-transition { min-width: 0; }
    @media (max-width: 32rem) {
      :global(.pagination-links) { grid-template-columns: 1fr; }
      :global(.pagination-links a[rel='next']:only-child) { grid-column: 1; }
    }
  }
</style>
