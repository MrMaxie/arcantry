---
import { Icon } from '@astrojs/starlight/components';
import markSvg from '../assets/arcantry-mark.svg?raw';

const markPath = (markSvg.match(/<path[^>]*\/>/)?.[0] ?? '').replace('fill="currentColor"', 'fill="url(#configuration-engine-text)"');

const presets = [
  { id: 'private', label: 'Private in an existing project', description: 'Use Arcantry without changing the repository.', icon: 'padlock' },
  { id: 'selective', label: 'Selective adoption', description: 'Connect a few capabilities in different scopes.', icon: 'puzzle' },
  { id: 'full', label: 'Complete integration', description: 'Adopt the full model in a new or existing project.', icon: 'rocket', status: 'Recommended' },
] as const;

const fields = [
  { id: 'skills', label: 'Skills', description: 'Reusable procedures that teach an agent how to perform a task.', icon: 'puzzle', options: [{ value: 'global', label: 'Global', icon: 'laptop' }, { value: 'repo', label: 'Project', icon: 'code-branch' }, { value: 'both', label: 'Both', icon: 'link' }, { value: 'none', label: 'Off', icon: 'close' }] },
  { id: 'settings', label: 'Agent settings', description: 'Defaults that shape agent behavior across projects or for this project.', icon: 'setting', options: [{ value: 'global', label: 'Global', icon: 'laptop' }, { value: 'repo', label: 'Project', icon: 'code-branch' }, { value: 'both', label: 'Both', icon: 'link' }, { value: 'none', label: 'Off', icon: 'close' }] },
  { id: 'local', label: '.local', description: 'A private, Git-ignored workspace for project-specific configuration.', icon: 'padlock', options: [{ value: 'use', label: 'Use', icon: 'approve-check' }, { value: 'omit', label: 'Skip', icon: 'close' }] },
  { id: 'todo', label: 'todo.txt', description: 'A plain-text task queue that can be private, shared, or both.', icon: 'notes', options: [{ value: 'repo', label: 'Project', icon: 'code-branch' }, { value: 'local', label: 'Private', icon: 'padlock' }, { value: 'both', label: 'Both', icon: 'link' }, { value: 'none', label: 'Off', icon: 'close' }] },
  { id: 'openspec', label: 'OpenSpec', description: 'Versioned product requirements and approved changes.', icon: 'open-book', options: [{ value: 'observe', label: 'Read', icon: 'open-book' }, { value: 'manage', label: 'Manage', icon: 'pencil' }, { value: 'omit', label: 'Off', icon: 'close' }] },
  { id: 'changelog', label: 'Changelog', description: 'The release history presented to people using the project.', icon: 'document', options: [{ value: 'observe', label: 'Read', icon: 'open-book' }, { value: 'manage', label: 'Manage', icon: 'pencil' }, { value: 'omit', label: 'Off', icon: 'close' }] },
] as const;
---

<section class="knowledge-configurator" aria-labelledby="knowledge-configurator-title">
  <div class="configurator-heading">
    <p>Compose your setup</p>
    <div>
      <h2 id="knowledge-configurator-title">See exactly what Arcantry connects</h2>
      <p>Start from a typical setup, then change any source or scope. The diagram updates to match the configuration you would actually adopt.</p>
    </div>
  </div>

  <arcantry-knowledge-graph data-preset="private">
    <div class="preset-grid" aria-label="Typical Arcantry configurations">
      {presets.map((preset, index) => (
        <button type="button" aria-pressed={index === 0 ? 'true' : 'false'} data-preset={preset.id}>
          <Icon name={preset.icon} />
          <span>
            <strong>{preset.label}</strong>
            <small>{preset.description}</small>
          </span>
          {'status' in preset && <em>{preset.status}</em>}
        </button>
      ))}
      <div class="custom-preset" data-custom-preset aria-live="polite">
        <Icon name="pencil" />
        <span><strong>Your own</strong><small>Adjusted to your choices.</small></span>
      </div>
    </div>

    <div class="configurator-stage">
      <form class="configuration-fields" aria-label="Arcantry source configuration">
        <div class="configuration-intro">
          <p data-configuration-title>{presets[0].label}</p>
          <span data-configuration-description>{presets[0].description}</span>
        </div>
        {fields.map((field) => (
          <div class="configuration-field" data-field-group={field.id}>
            <div class="field-heading">
              <span class="field-icon"><Icon name={field.icon} /></span>
              <span>
                <strong id={`configuration-${field.id}-label`}>{field.label}</strong>
                <small>{field.description}</small>
              </span>
            </div>
            <div class="field-control">
              <div class="field-options" role="radiogroup" aria-labelledby={`configuration-${field.id}-label`}>
                {field.options.map((option) => (
                  <button type="button" role="radio" aria-checked="false" aria-label={`${field.label}: ${option.label}`} data-field={field.id} data-value={option.value}>
                    <Icon name={option.icon} /><span>{option.label}</span>
                  </button>
                ))}
              </div>
              <p class="field-consequence" data-field-consequence={field.id} aria-live="polite"></p>
            </div>
          </div>
        ))}
      </form>

      <div class="configuration-graph">
        <svg viewBox="0 0 1040 430" role="img" data-configuration-visual>
          <defs>
            <linearGradient id="configuration-engine-stroke" x1="300" y1="0" x2="520" y2="0" gradientUnits="userSpaceOnUse" spreadMethod="reflect">
              <stop offset="0%" stop-color="var(--ar-accent-blue)" />
              <stop offset="42%" stop-color="var(--ar-accent-violet)" />
              <stop offset="52%" stop-color="var(--ar-text)" />
              <stop offset="62%" stop-color="var(--ar-accent-pink)" />
              <stop offset="100%" stop-color="var(--ar-accent-pink)" />
              <animate attributeName="x1" values="300;740" dur="4.8s" repeatCount="indefinite" />
              <animate attributeName="x2" values="520;960" dur="4.8s" repeatCount="indefinite" />
            </linearGradient>
            <linearGradient id="configuration-engine-text" x1="300" y1="0" x2="520" y2="0" gradientUnits="userSpaceOnUse" spreadMethod="reflect">
              <stop offset="0%" stop-color="var(--ar-accent-blue)" />
              <stop offset="38%" stop-color="var(--ar-accent-violet)" />
              <stop offset="50%" stop-color="var(--ar-text)" />
              <stop offset="62%" stop-color="var(--ar-accent-pink)" />
              <stop offset="100%" stop-color="var(--ar-accent-pink)" />
              <animate attributeName="x1" values="300;740" dur="4.8s" repeatCount="indefinite" />
              <animate attributeName="x2" values="520;960" dur="4.8s" repeatCount="indefinite" />
            </linearGradient>
            <symbol id="source-icon-skill" viewBox="0 0 20 20"><path d="M7.5 3H5a2 2 0 0 0-2 2v2.5h1.5a2 2 0 1 1 0 4H3V15a2 2 0 0 0 2 2h2.5v-1.5a2 2 0 1 1 4 0V17H15a2 2 0 0 0 2-2v-3.5h-1.5a2 2 0 1 1 0-4H17V5a2 2 0 0 0-2-2h-3.5v1.5a2 2 0 1 1-4 0Z" /></symbol>
            <symbol id="source-icon-settings" viewBox="0 0 20 20"><circle cx="10" cy="10" r="2.5" /><path d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M15.3 4.7l-1.4 1.4M6.1 13.9l-1.4 1.4" /></symbol>
            <symbol id="source-icon-todo" viewBox="0 0 20 20"><rect x="4" y="3" width="12" height="14" rx="2" /><path d="M7 7h6M7 10h6M7 13h4M7 3.5V2M13 3.5V2" /></symbol>
            <symbol id="source-icon-book" viewBox="0 0 20 20"><path d="M3 4.5A2.5 2.5 0 0 1 5.5 2H9v14H5.5A2.5 2.5 0 0 0 3 18.5ZM17 4.5A2.5 2.5 0 0 0 14.5 2H11v14h3.5a2.5 2.5 0 0 1 2.5 2.5Z" /></symbol>
            <symbol id="source-icon-document" viewBox="0 0 20 20"><path d="M5 2.5h6l4 4V17.5H5Z" /><path d="M11 2.5v4h4M7.5 10h5M7.5 13h5" /></symbol>
            <symbol id="source-icon-lock" viewBox="0 0 20 20"><rect x="4" y="8" width="12" height="9" rx="2" /><path d="M7 8V6a3 3 0 0 1 6 0v2M10 11.5v2" /></symbol>
            <filter id="configuration-edge-glow" x="-40%" y="-40%" width="180%" height="180%">
              <feGaussianBlur stdDeviation="4" result="blur" />
              <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
          </defs>

          <g class="engine-node">
            <rect x="410" y="18" width="220" height="92" rx="5" />
            <g class="engine-mark" transform="translate(493 25) scale(.1534)" set:html={markPath} />
            <text class="engine-role" x="520" y="82" text-anchor="middle">your configured knowledge map</text>
          </g>

          <g class="scope-edges" filter="url(#configuration-edge-glow)">
            <path data-scope-edge="global" d="M465 110 V145 H170 V175" />
            <path data-scope-edge="repository" d="M520 110 V175" />
            <path data-scope-edge="local" d="M575 110 V145 H870 V175" />
          </g>

          <g class="scope" data-scope="global">
            <rect class="scope-boundary" x="20" y="175" width="300" height="225" rx="6" />
            <circle class="scope-hub" cx="170" cy="175" r="5" />
            <text class="boundary-label" x="40" y="202">COMPUTER</text>
          </g>
          <g class="source-node" data-source="global-skills"><rect x="50" y="225" width="240" height="54" rx="4" /><use href="#source-icon-skill" x="64" y="244" width="16" height="16" /><text class="source-name" x="92" y="257">Global skills</text></g>
          <g class="source-node" data-source="global-settings"><rect x="50" y="299" width="240" height="54" rx="4" /><use href="#source-icon-settings" x="64" y="318" width="16" height="16" /><text class="source-name" x="92" y="331">Global settings</text></g>

          <g class="scope" data-scope="repository">
            <rect class="scope-boundary" x="370" y="175" width="300" height="225" rx="6" />
            <circle class="scope-hub" cx="520" cy="175" r="5" />
            <text class="boundary-label" x="390" y="202">REPOSITORY</text>
          </g>
          <g class="source-node compact" data-source="repo-skills"><rect x="390" y="221" width="126" height="48" rx="4" /><use href="#source-icon-skill" x="400" y="237" width="16" height="16" /><text class="source-name" x="425" y="250">Skills</text></g>
          <g class="source-node compact" data-source="repo-settings"><rect x="528" y="221" width="122" height="48" rx="4" /><use href="#source-icon-settings" x="538" y="237" width="16" height="16" /><text class="source-name" x="563" y="250">Settings</text></g>
          <g class="source-node compact" data-source="repo-todo"><rect x="390" y="283" width="126" height="48" rx="4" /><use href="#source-icon-todo" x="400" y="299" width="16" height="16" /><text class="source-name" x="425" y="312">todo.txt</text></g>
          <g class="source-node compact" data-source="openspec"><rect x="528" y="283" width="122" height="48" rx="4" /><use href="#source-icon-book" x="538" y="299" width="16" height="16" /><text class="source-name" x="563" y="312">OpenSpec</text></g>
          <g class="source-node compact" data-source="changelog"><rect x="459" y="345" width="142" height="42" rx="4" /><use href="#source-icon-document" x="469" y="358" width="16" height="16" /><text class="source-name" x="494" y="371">Changelog</text></g>

          <g class="scope" data-scope="local">
            <rect class="scope-boundary" x="720" y="175" width="300" height="225" rx="6" />
            <circle class="scope-hub" cx="870" cy="175" r="5" />
            <text class="boundary-label" x="740" y="202">PRIVATE PER PROJECT</text>
          </g>
          <g class="source-node" data-source="local-config"><rect x="750" y="225" width="240" height="54" rx="4" /><use href="#source-icon-lock" x="764" y="244" width="16" height="16" /><text class="source-name" x="792" y="257">Local configuration</text></g>
          <g class="source-node" data-source="local-todo"><rect x="750" y="299" width="240" height="54" rx="4" /><use href="#source-icon-todo" x="764" y="318" width="16" height="16" /><text class="source-name" x="792" y="331">Private todo.txt</text></g>
        </svg>

        <div class="configuration-legend" aria-hidden="true">
          <span><i class="observed"></i>Observed or linked</span>
          <span><i class="managed"></i>Managed in repo</span>
          <span><i class="private"></i>Private in .local</span>
        </div>
      </div>
    </div>
  </arcantry-knowledge-graph>
</section>

<script>
  type PresetId = 'private' | 'selective' | 'full';
  type Configuration = {
    skills: 'global' | 'repo' | 'both' | 'none';
    settings: 'global' | 'repo' | 'both' | 'none';
    local: 'use' | 'omit';
    todo: 'repo' | 'local' | 'both' | 'none';
    openspec: 'observe' | 'manage' | 'omit';
    changelog: 'observe' | 'manage' | 'omit';
  };
  type ConfigurationField = keyof Configuration;
  type SourceMode = 'observed' | 'managed' | 'private' | null;

  const presetOrder: PresetId[] = ['private', 'selective', 'full'];
  const fixedPresetConfigurations: Record<Exclude<PresetId, 'selective'>, Configuration> = {
    private: { skills: 'global', settings: 'global', local: 'use', todo: 'local', openspec: 'omit', changelog: 'omit' },
    full: { skills: 'repo', settings: 'repo', local: 'use', todo: 'both', openspec: 'manage', changelog: 'manage' },
  };
  const selectiveConfigurations: Configuration[] = [
    { skills: 'global', settings: 'none', local: 'use', todo: 'repo', openspec: 'observe', changelog: 'omit' },
    { skills: 'repo', settings: 'global', local: 'omit', todo: 'local', openspec: 'omit', changelog: 'observe' },
    { skills: 'both', settings: 'none', local: 'use', todo: 'none', openspec: 'manage', changelog: 'observe' },
    { skills: 'none', settings: 'repo', local: 'use', todo: 'both', openspec: 'observe', changelog: 'omit' },
  ];
  const presetCopy: Record<PresetId, { title: string; description: string }> = {
    private: { title: 'Private in an existing project', description: 'The repository stays untouched while this computer keeps private project context and tasks.' },
    selective: { title: 'Selective adoption', description: 'Only the capabilities shown below are connected. The rest of the project stays independent.' },
    full: { title: 'Complete integration', description: 'Arcantry manages the complete shared model while .local keeps private project context.' },
  };
  const fieldConsequences: Record<ConfigurationField, Record<string, string>> = {
    skills: {
      global: 'The same procedures are available on this computer across projects.',
      repo: 'The project carries and versions its own procedures.',
      both: 'Computer-wide and project-owned procedures are both available.',
      none: 'Arcantry does not connect agent procedures.',
    },
    settings: {
      global: 'Computer-wide defaults shape agent behavior in this project.',
      repo: 'The repository carries project-specific agent defaults.',
      both: 'Computer defaults and repository settings are combined.',
      none: 'Arcantry does not add agent settings.',
    },
    local: {
      use: 'Private project context stays outside Git on this computer.',
      omit: 'No private per-project Arcantry workspace is used.',
    },
    todo: {
      repo: 'The task queue is shared and reviewed with the repository.',
      local: 'The task queue stays private to this project on this computer.',
      both: 'Private and shared task queues remain separate and available.',
      none: 'Arcantry does not connect a task queue.',
    },
    openspec: {
      observe: 'Arcantry reads project requirements without managing them.',
      manage: 'Requirements and approved changes become part of the managed model.',
      omit: 'Arcantry does not connect project requirements.',
    },
    changelog: {
      observe: 'Arcantry reads release history without managing it.',
      manage: 'Release history becomes a managed projection of project changes.',
      omit: 'Arcantry does not connect release history.',
    },
  };

  const configurationForPreset = (preset: PresetId): Configuration => {
    if (preset !== 'selective') return { ...fixedPresetConfigurations[preset] };
    const index = Math.floor(Math.random() * selectiveConfigurations.length);
    return { ...selectiveConfigurations[index] };
  };

  class ArcantryKnowledgeGraph extends HTMLElement {
    private activePreset: PresetId | 'custom' = 'private';
    private configuration: Configuration = configurationForPreset('private');
    private timer: number | undefined;
    private manual = false;
    private motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    connectedCallback(): void {
      this.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button) => button.addEventListener('click', this.selectPreset));
      this.querySelectorAll<HTMLButtonElement>('[data-field]').forEach((button) => button.addEventListener('click', this.selectField));
      this.addEventListener('pointerenter', this.pause);
      this.addEventListener('pointerleave', this.resume);
      this.addEventListener('focusin', this.pause);
      this.addEventListener('focusout', this.resume);
      this.motionQuery.addEventListener('change', this.handleMotionChange);
      this.render();
      this.syncMotion();
    }

    disconnectedCallback(): void {
      this.pause();
      this.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button) => button.removeEventListener('click', this.selectPreset));
      this.querySelectorAll<HTMLButtonElement>('[data-field]').forEach((button) => button.removeEventListener('click', this.selectField));
      this.removeEventListener('pointerenter', this.pause);
      this.removeEventListener('pointerleave', this.resume);
      this.removeEventListener('focusin', this.pause);
      this.removeEventListener('focusout', this.resume);
      this.motionQuery.removeEventListener('change', this.handleMotionChange);
    }

    private selectPreset = (event: Event): void => {
      const button = event.currentTarget;
      if (!(button instanceof HTMLButtonElement)) return;
      const preset = button.dataset.preset as PresetId;
      if (!presetOrder.includes(preset)) return;
      this.manual = true;
      this.pause();
      this.activePreset = preset;
      this.configuration = configurationForPreset(preset);
      this.render();
    };

    private selectField = (event: Event): void => {
      const button = event.currentTarget;
      if (!(button instanceof HTMLButtonElement)) return;
      const field = button.dataset.field as ConfigurationField;
      const value = button.dataset.value;
      if (!field || !value) return;
      this.manual = true;
      this.pause();
      this.activePreset = 'custom';
      this.configuration = { ...this.configuration, [field]: value } as Configuration;
      this.render();
    };

    private render(): void {
      this.dataset.preset = this.activePreset;
      this.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.preset === this.activePreset)));
      this.querySelector<HTMLElement>('[data-custom-preset]')?.toggleAttribute('data-active', this.activePreset === 'custom');
      this.querySelectorAll<HTMLButtonElement>('[data-field]').forEach((button) => {
        const field = button.dataset.field as ConfigurationField;
        button.setAttribute('aria-checked', String(this.configuration[field] === button.dataset.value));
      });
      this.querySelectorAll<HTMLElement>('[data-field-consequence]').forEach((consequence) => {
        const field = consequence.dataset.fieldConsequence as ConfigurationField;
        consequence.textContent = fieldConsequences[field][this.configuration[field]];
      });

      const copy = this.activePreset === 'custom'
        ? { title: 'Your own setup', description: 'The map now reflects the individual choices below. Automatic changes are paused.' }
        : presetCopy[this.activePreset];
      const title = this.querySelector<HTMLElement>('[data-configuration-title]');
      const description = this.querySelector<HTMLElement>('[data-configuration-description]');
      if (title) title.textContent = copy.title;
      if (description) description.textContent = copy.description;

      const sourceModes = this.getSourceModes();
      this.querySelectorAll<SVGElement>('[data-source]').forEach((node) => {
        const mode = sourceModes[node.dataset.source ?? ''];
        node.toggleAttribute('data-active', mode !== null);
        if (mode) node.dataset.mode = mode;
        else delete node.dataset.mode;
      });
      ['global', 'local', 'repository'].forEach((scope) => {
        const active = this.scopeIsActive(scope, sourceModes);
        this.querySelector<SVGElement>(`[data-scope="${scope}"]`)?.toggleAttribute('data-active', active);
        this.querySelector<SVGPathElement>(`[data-scope-edge="${scope}"]`)?.toggleAttribute('data-active', active);
      });
      this.querySelector<SVGElement>('[data-configuration-visual]')?.setAttribute('aria-label', this.describeConfiguration());
    }

    private getSourceModes(): Record<string, SourceMode> {
      const includes = (value: string, location: 'global' | 'repo' | 'local'): boolean => value === location || value === 'both';
      return {
        'global-skills': includes(this.configuration.skills, 'global') ? 'observed' : null,
        'global-settings': includes(this.configuration.settings, 'global') ? 'observed' : null,
        'local-config': this.configuration.local === 'use' ? 'private' : null,
        'local-todo': includes(this.configuration.todo, 'local') ? 'private' : null,
        'repo-skills': includes(this.configuration.skills, 'repo') ? 'managed' : null,
        'repo-settings': includes(this.configuration.settings, 'repo') ? 'managed' : null,
        'repo-todo': includes(this.configuration.todo, 'repo') ? 'managed' : null,
        openspec: this.configuration.openspec === 'omit' ? null : this.configuration.openspec === 'manage' ? 'managed' : 'observed',
        changelog: this.configuration.changelog === 'omit' ? null : this.configuration.changelog === 'manage' ? 'managed' : 'observed',
      };
    }

    private scopeIsActive(scope: string, sourceModes: Record<string, SourceMode>): boolean {
      const sourcesByScope: Record<string, string[]> = {
        global: ['global-skills', 'global-settings'],
        local: ['local-config', 'local-todo'],
        repository: ['repo-skills', 'repo-settings', 'repo-todo', 'openspec', 'changelog'],
      };
      return (sourcesByScope[scope] ?? []).some((source) => sourceModes[source] !== null);
    }

    private describeConfiguration(): string {
      return `Skills: ${this.configuration.skills}; agent settings: ${this.configuration.settings}; .local: ${this.configuration.local}; todo.txt: ${this.configuration.todo}; OpenSpec: ${this.configuration.openspec}; Changelog: ${this.configuration.changelog}.`;
    }

    private start = (): void => {
      this.pause();
      if (this.manual || this.motionQuery.matches) return;
      this.timer = window.setInterval(() => {
        const current = presetOrder.indexOf(this.activePreset as PresetId);
        const next = presetOrder[(current + 1) % presetOrder.length];
        this.activePreset = next;
        this.configuration = configurationForPreset(next);
        this.render();
      }, 6500);
    };

    private pause = (): void => {
      if (this.timer !== undefined) window.clearInterval(this.timer);
      this.timer = undefined;
    };

    private resume = (): void => {
      window.setTimeout(() => {
        if (!this.matches(':hover') && !this.contains(document.activeElement)) this.start();
      }, 0);
    };

    private syncMotion = (): void => {
      const visual = this.querySelector<SVGSVGElement>('[data-configuration-visual]');
      if (this.motionQuery.matches) visual?.pauseAnimations();
      else visual?.unpauseAnimations();
      this.start();
    };

    private handleMotionChange = (): void => this.syncMotion();
  }

  if (!customElements.get('arcantry-knowledge-graph')) customElements.define('arcantry-knowledge-graph', ArcantryKnowledgeGraph);
</script>

<style>
  @layer starlight.core {
    .knowledge-configurator { margin: 0 0 5.5rem; }
    .configurator-heading { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: 2rem; align-items: start; margin-bottom: 1.35rem; }
    .configurator-heading > p { margin: .45rem 0 0; color: var(--ar-accent-pink); font-size: .67rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
    .configurator-heading h2 { max-width: 20ch; margin: 0; color: var(--ar-text); font-family: var(--ar-font-section); font-size: clamp(2rem, 3.4vw, 3.7rem); font-variation-settings: 'opsz' 72, 'SOFT' 40, 'WONK' 1; font-weight: 470; letter-spacing: -.035em; line-height: 1.04; }
    .configurator-heading div > p { max-width: 43rem; margin: 1rem 0 0; color: var(--ar-text-muted); font-size: .92rem; line-height: 1.7; }
