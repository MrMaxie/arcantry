[toml-schema]
version = "1.0.0"

[toml-schema.meta]
title = "Arcantry project configuration"
application_version = 1

[types.schema_reference]
type = "table"
description = "Optional TOML Schema discovery metadata."

[types.schema_reference.location]
type = "string"
minlength = 1

[types.schema_reference.version]
type = "string"
pattern = "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
optional = true

[types.tool]
type = "table"
description = "Compatibility requirements for the Arcantry CLI."

[types.tool.requires]
type = "string"
minlength = 1

[types.project]
type = "table"
description = "Project resolution relative to this configuration file."

[types.project.root]
type = "string"
minlength = 1

[types.source]
type = "table"
description = "One independently managed project knowledge source."

[types.source.kind]
type = "string"
allowedvalues = ["openspec", "changelog", "todo-txt"]

[types.source.path]
type = "string"
minlength = 1

[types.source.management]
type = "string"
allowedvalues = ["ignore", "observe", "validate", "manage"]
optional = true

[types.source.adapter]
type = "string"
pattern = "^[a-z][a-z0-9-]*@[0-9]+$"

[types.source.from]
type = "array"
arraytype = "string"
optional = true

[types.source.managed_from]
type = "string"
pattern = "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
optional = true

[types.source.visibility]
type = "string"
allowedvalues = ["shared", "private"]
optional = true

[types.source.scope]
type = "string"
minlength = 1
optional = true

[types.release_version_source]
type = "table"
description = "One explicitly versioned distribution source updated by local release planning."

[types.release_version_source.path]
type = "string"
minlength = 1

[types.release_version_source.adapter]
type = "string"
allowedvalues = ["json-package@1", "cargo-workspace@1"]

[types.release]
type = "table"
description = "Optional versioned OpenSpec release system. Runtime validation enforces the selected adapter and topology shape."

[types.release.adapter]
type = "string"
allowedvalues = ["openspec-release@1", "openspec-release@2"]

[types.release.topology]
type = "string"
allowedvalues = ["single", "independent", "composed"]
optional = true

[types.release.manifests_path]
type = "string"
minlength = 1
optional = true

[types.release.changelog_source]
type = "string"
minlength = 1
optional = true

[types.release.tag_prefix]
type = "string"
minlength = 1
optional = true

[types.release.repository_url]
type = "string"
minlength = 1
optional = true

[types.release.version_sources]
type = "array"
arraytype = "types.release_version_source"
optional = true

[types.release.units]
type = "collection"
itemtype = "types.release_unit"
keypattern = "^[A-Za-z0-9][A-Za-z0-9._-]*$"
optional = true

[types.release_unit]
type = "table"
description = "One independently versioned release unit in a multi-unit v2 release system."

[types.release_unit.manifests_path]
type = "string"
minlength = 1

[types.release_unit.changelog_source]
type = "string"
minlength = 1

[types.release_unit.tag_prefix]
type = "string"
minlength = 1

[types.release_unit.dependencies]
type = "array"
arraytype = "string"
optional = true

[types.release_unit.version_sources]
type = "array"
arraytype = "types.release_version_source"

[types.release_unit.selectors]
type = "array"
arraytype = "types.release_unit_selector"

[types.release_unit_selector]
type = "table"
description = "An OpenSpec source claim, optionally narrowed to stable component ids."

[types.release_unit_selector.source]
type = "string"
minlength = 1

[types.release_unit_selector.components]
type = "array"
arraytype = "string"
optional = true

[elements.config_version]
type = "integer"
min = 1
max = 1

[elements.tool]
type = "types.tool"
optional = true

[elements.project]
type = "types.project"
optional = true

[elements.sources]
type = "collection"
itemtype = "types.source"
keypattern = "^[A-Za-z0-9][A-Za-z0-9._-]*$"
optional = true

[elements.release]
type = "types.release"
optional = true
