{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxie.dev/arcantry/schemas/catalog.schema.json",
  "title": "Arcantry skill catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "skills"],
  "properties": {
    "$schema": {
      "const": "./schemas/catalog.schema.json"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "family", "tags"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 63
          },
          "family": {
            "enum": ["self-improvement", "repo-safely", "content-safely"]
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        }
      }
    }
  }
}
