{
  "name": "arcantry",
  "version": "1.0.0",
  "description": "Arcantry repository adoption, skill catalog, and agent integration CLI.",
  "type": "module",
  "bin": {
    "arcantry": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./repository": {
      "types": "./dist/repository.d.ts",
      "import": "./dist/repository.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js"
    },
    "./release": {
      "types": "./dist/release.d.ts",
      "import": "./dist/release.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    "dist",
    "skills",
    "catalog.json",
    "assets",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "package:check": "pnpm run prepack && node scripts/check-package.mjs",
    "prepack": "pnpm run build && pnpm --dir ../.. exec tsx tooling/prepare-package.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "homepage": "https://maxie.dev/arcantry/",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrMaxie/arcantry.git"
  },
  "bugs": {
    "url": "https://github.com/MrMaxie/arcantry/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "14.0.3",
    "execa": "9.6.1",
    "semver": "7.8.5",
    "smol-toml": "1.7.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.7.0",
    "@types/semver": "7.8.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
