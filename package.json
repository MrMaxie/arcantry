{
  "name": "arcantry-workspace",
  "private": true,
  "type": "module",
  "packageManager": "nub@0.7.5",
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@fission-ai/openspec": "1.10.0",
    "@types/node": "26.3.0",
    "cheerio": "1.2.0",
    "commander": "14.0.3",
    "execa": "9.6.1",
    "marked": "18.0.11",
    "typescript": "7.0.2",
    "verdaccio": "6.10.0",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  },
  "allowBuilds": {
    "@fission-ai/openspec": true,
    "esbuild": true
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "0.7.5",
      "onFail": "ignore"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
