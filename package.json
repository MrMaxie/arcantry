{
  "name": "arcantry",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "astro build",
    "check": "pnpm run check:types && pnpm run test && pnpm run release:check && pnpm run docs:check",
    "check:types": "astro sync && tsc --noEmit",
    "dev": "astro dev",
    "docs:check": "astro check",
    "preview": "astro preview",
    "release:check": "tsx tooling/release.ts check",
    "release:cut": "tsx tooling/release.ts cut",
    "release:plan": "tsx tooling/release.ts plan",
    "release:render": "tsx tooling/release.ts render",
    "test": "vitest run"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/starlight": "0.41.7",
    "@fission-ai/openspec": "1.9.0",
    "astro": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@fission-ai/openspec",
      "esbuild"
    ]
  }
}
