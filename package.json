{
  "name": "arcantry-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm --filter ./packages/arcantry run build && astro build",
    "catalog:validate": "tsx tooling/validate-catalog.ts",
    "check": "pnpm run check:types && pnpm run test && pnpm run catalog:validate && pnpm run generate:check && pnpm run release:check && pnpm run docs:check",
    "check:types": "astro sync && tsc --noEmit && pnpm --filter ./packages/arcantry run typecheck",
    "dev": "astro dev",
    "docs:check": "astro check",
    "generate": "tsx tooling/generate.ts",
    "generate:check": "tsx tooling/generate.ts --check",
    "package:check": "pnpm --filter ./packages/arcantry run package:check",
    "publish:check": "tsx tooling/publish.ts check",
    "preview": "astro preview",
    "release:check": "tsx tooling/release.ts check",
    "release:cut": "tsx tooling/release.ts cut",
    "release:plan": "tsx tooling/release.ts plan",
    "release:render": "tsx tooling/release.ts render",
    "test": "vitest run tooling && pnpm --filter ./packages/arcantry run test"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/starlight": "0.41.7",
    "@fission-ai/openspec": "1.9.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "astro": "7.2.2",
    "beautiful-mermaid": "1.1.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@fission-ai/openspec",
      "esbuild"
    ]
  }
}
