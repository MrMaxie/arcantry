{
  "name": "arcantry-workspace",
  "private": true,
  "type": "module",
  "packageManager": "nub@0.7.5",
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@fission-ai/openspec": "1.9.0",
    "@types/node": "25.7.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "allowBuilds": {
    "@fission-ai/openspec": true,
    "esbuild": true
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "0.7.5",
      "onFail": "ignore"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
