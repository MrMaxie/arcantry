{
  "name": "arcantry-workspace",
  "private": true,
  "type": "module",
  "packageManager": "nub@0.7.5",
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@fission-ai/openspec": "1.9.0",
    "verdaccio": "6.10.0"
  },
  "allowBuilds": {
    "@fission-ai/openspec": true,
    "esbuild": true
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "0.7.5",
      "onFail": "ignore"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
